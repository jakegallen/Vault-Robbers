// PAID-ENTRY RECOVERY (Jake 2026-09-07): a paid entry can hang so hard the wallet never returns the tx hash, stranding a player
// who was charged but never got in. We stashed the runId at bind-time; here we confirm the payment straight from the contract
// (verify-enter works by runId now, no hash) and, ONLY for a still-open run that never played a door (depth 0, same committed
// seed → no re-roll, no cheat), drop the player into chamber 1. Anything already progressed/ended is left to no-resume. Never throws.
async function recoverPendingEntry(){
  if(RUN)return;
  let p; try{ p=JSON.parse(localStorage.getItem('rtv_pending_entry')||'null'); }catch(_){ }
  if(!p||!p.runId)return;
  if(Date.now()-(p.ts||0) > 2*3600*1000){ try{localStorage.removeItem('rtv_pending_entry')}catch(_){}; return; }   // stale (>2h) — drop
  try{
    const v=await api('api/onchain/verify-enter',{runId:p.runId});
    if(!v||!v.paid)return;   // not confirmed yet (still mining) or never paid — leave the breadcrumb for a later attempt
    const r=await api('api/run/'+p.runId);
    if(RUN)return;   // a run started while awaiting — abort
    if(!r||!r.ok||!r.alive||Number(r.depth)!==0){ try{localStorage.removeItem('rtv_pending_entry')}catch(_){}; return; }   // progressed or ended — no safe restore
    RUN={runId:p.runId,chips:Number(r.chips)||((CFG&&CFG.chips)||0),depth:0,mult:Number(r.mult)||1,doors:r.doors,hash:r.hash,clientSeed:r.clientSeed,onchain:true,paid:true};
    try{localStorage.removeItem('rtv_pending_entry')}catch(_){}
    saveActiveRun();
    try{ $('#startO').classList.remove('on'); }catch(_){}
    try{ buildChamber(0); hud(); engage(); }catch(_){}
    try{ toast('Recovered your paid entry. You are in, no second charge.',5500); }catch(_){}
  }catch(e){ /* leave the breadcrumb; a later load/retry picks it up */ }
}
