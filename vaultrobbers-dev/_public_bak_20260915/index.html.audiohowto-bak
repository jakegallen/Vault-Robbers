      straight_to_door:((b.turns<=1&&b.browse<=1&&b.moves<40&&(b.firstT?b.firstT-b.t0:dur)<2500)?1:0),
      // positive-human signals (Task 4): a bot rarely toggles language or audio. Booleans + counts; server folds these into humanness.
      lang_changed:((window.__rtvLangChanges||0)>0), lang_change_count:(window.__rtvLangChanges||0),
