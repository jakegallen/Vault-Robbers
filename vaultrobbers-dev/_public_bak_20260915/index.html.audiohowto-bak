    addEventListener('pointermove', function(e){ try{ B.moves++;
      // Prefer movementX/Y (pointer-lock look in the 3D world; clientX/Y stay frozen while looking). Fall back to client-delta for menu/2D pointer.
      var mx=(typeof e.movementX==='number'&&e.movementX)?e.movementX:( (B.lastX||B.lastY)? (e.clientX-B.lastX):0 );
      var my=(typeof e.movementY==='number'&&e.movementY)?e.movementY:( (B.lastX||B.lastY)? (e.clientY-B.lastY):0 );
      var d=Math.sqrt(mx*mx+my*my); B.dist+=d; if(d>0&&d<3)B.jit++;
      if(Math.abs(mx)>2&&((mx<0)!==(B.lastDX<0)))B.revX++; if(Math.abs(mx)>2)B.lastDX=mx;
      B.lastX=e.clientX; B.lastY=e.clientY; }catch(_){} }, {passive:true});
    addEventListener('pointerdown', function(){ try{ B.down=Date.now(); }catch(_){} }, {passive:true});
    addEventListener('pointerup', function(){ try{ if(B.down){ var h=Date.now()-B.down; B.holds++; B.holdSum+=h; if(h>B.holdMax)B.holdMax=h; B.down=0; } }catch(_){} }, {passive:true});
    addEventListener('keydown', function(e){ try{ var k=(e.key||'').toLowerCase(); if(!B.firstT)B.firstT=Date.now(); B.keys++; B.km[k]=(B.km[k]||0)+1; if(k==='a'||k==='d'||k==='arrowleft'||k==='arrowright'){ B.turns++; B.browse++; } }catch(_){} }, {passive:true});
    addEventListener('click', function(e){ try{ if(!B.firstT)B.firstT=Date.now(); B.clicks++; var t=e.target; var txt=((t&&t.textContent)||'').toLowerCase(); var hit=t&&t.closest&&t.closest('button,a,canvas,input,select,[role=button],.door,.game,.pill,.go,.how'); if(!hit)B.dead++; if(/how it works|how to play|howitworks/.test(txt)||(t&&t.id&&/how/i.test(String(t.id))))B.how++; if(/[◄►]|next|prev|arrow/.test(txt))B.browse++; if(/leave|back out|exit/.test(txt))B.leave++; if(/mint|robber/.test(txt))B.robber++; }catch(_){} }, true);
    function flush(runId, level){ try{ if(!runId)return; var b=B, dur=Date.now()-b.t0; var body={ runId:runId, level:level, behavior:{
