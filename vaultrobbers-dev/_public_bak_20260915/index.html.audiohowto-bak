   called exactly once and its promise always returned, so this can never affect gameplay. Relative fetch path per proxy rules. */
(function(){
  try{
    function fresh(){ return { t0:Date.now(), firstT:0, moves:0, dist:0, revX:0, turns:0, keys:0, km:{}, clicks:0, dead:0, how:0, browse:0, leave:0, robber:0, holds:0, holdSum:0, holdMax:0, down:0, jit:0, lastX:0, lastY:0, lastDX:0 }; }
