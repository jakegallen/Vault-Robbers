      fetch('api/clientenv',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({runId:runId,signals:ENV}),keepalive:true}).catch(function(){}); }catch(_){} }
    var _f=window.fetch;
    window.fetch=function(){ var self=this,args=arguments;
      try{ var url=String((args[0]&&args[0].url)||args[0]||''); var opts=args[1]||{};
        // fire once per run: as soon as we can read a run_id off a crack/run/verify-enter call
        if(/api\/(crack|run|onchain\/verify-enter)\b/.test(url)&&opts&&typeof opts.body==='string'){ try{ var rid=JSON.parse(opts.body).runId; if(rid)send(rid); }catch(_){} }
      }catch(_){}
      return _f.apply(self,args);
    };
  }catch(_){}
})();
