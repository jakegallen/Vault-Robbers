        ctx.textBaseline='top'; ctx.font="14px 'Arial'"; ctx.fillStyle='#f60'; ctx.fillRect(0,0,100,20); ctx.fillStyle='#069'; ctx.fillText('rtv-env-probe ✨',2,2);
        var d=cv.toDataURL(); var h=5381; for(var i=0;i<d.length;i++){ h=((h<<5)+h+d.charCodeAt(i))>>>0; } s.canvasHash=h.toString(16);
      }catch(_){}
      try{ s.pluginsLength = (navigator.plugins&&typeof navigator.plugins.length==='number')?navigator.plugins.length:0; }catch(_){}
      try{ s.chrome = (typeof window.chrome!=='undefined'&&window.chrome!==null); }catch(_){}
