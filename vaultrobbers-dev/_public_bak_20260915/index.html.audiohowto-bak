<script>
/* Mobile session guard: a plain target="_blank" anchor (View on OpenSea / explorer / transaction, socials) often navigates
   the game away IN-PLACE inside mobile + in-app browsers, wiping the run and forcing a restart. Intercept those taps and
   open the link via window.open from this user gesture so the game tab stays alive; only fall back to normal navigation if
   the browser blocks the popup, so the link never dies. */
document.addEventListener('click', function(e){
  var a = e.target && e.target.closest && e.target.closest('a[target="_blank"]');
  if(!a) return;
  var href = a.getAttribute('href');
  if(!href || href === '#' || href.charAt(0) === '#' || /^javascript:/i.test(href)) return;
  try{ var w = window.open(href, '_blank', 'noopener'); if(w){ e.preventDefault(); } }catch(_){}
}, true);
