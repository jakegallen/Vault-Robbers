const HALLOWEEN_MS = Date.UTC(2026, 9, 31, 0, 0, 0);   // Oct 31 2026 (month is 0-indexed)
function doomInfo(){
  // AUDIT M (#103): the ?doom=<days> preview override is a DEV tool; gate it to the password-gated stage host only (same rule as
  // DEVTOOLS, inlined so it doesn't depend on that later-declared const). On public prod the param is ignored and the real countdown runs.
  const _doomDev = (()=>{ try{ return location.hostname.startsWith('stage.'); }catch(e){ return false; } })();
  let ms; const ov = _doomDev ? new URLSearchParams(location.search).get('doom') : null;   // ?doom=<days left> to preview the siren + breach (stage only)
  ms = (ov != null) ? parseFloat(ov) * 86400000 : (HALLOWEEN_MS - Date.now());
  const days = ms / 86400000;
  return { ms, days, active: days <= 14, intensity: Math.max(0, Math.min(1, (14 - days) / 14)), breach: ms <= 0 };
}
