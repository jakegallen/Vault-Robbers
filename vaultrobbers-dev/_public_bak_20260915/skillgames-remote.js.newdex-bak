  function pOrbitRing(canvas, st) { const rad = st.data.rad || 0.3, dur = st.data.dur || 7000;
    // The ring is drawn as an ELLIPSE at rad*w (horizontal) and rad*h (vertical) centred exactly at (0.5,0.5) in normalized
