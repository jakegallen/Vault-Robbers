      else { if (dp < 0.5) lit = show[Math.floor(dp / 0.5 * show.length) % show.length]; else { const kk = Math.floor((dp - 0.5) / 0.5 * show.length); done = show.slice(0, Math.min(show.length, kk + 1)); } }
