  function pWheel(canvas) { const SY = ['💎', '🔑', '💰', '🍒', '7', '★', '🪙', '◆']; return fateGame(canvas, { title: 'FORTUNE WHEEL', tap: 'TAP TO SPIN', dur: 1600, draw(g, w, h, ph, s, cx, cy) { const R = Math.min(w, h - 30) * 0.32, ang = _ez(ph) * Math.PI * 9;
