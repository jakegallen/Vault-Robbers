    return _dxDrag(canvas, st, 'WIRE TRACE', 'TRACE THE WIRE WITHOUT DRIFTING OFF', function (g, w, h, t, cur, dragging) { const x0 = 24, x1 = w - 24, y0 = 46, yh = h - 90; const wy = nx => y0 + (0.5 + amp * Math.sin(fx2 * nx + ph)) * yh;
