    accentonly: { t: 'Accent Only', d: ['Steady pulses, the accents are a bit louder/bigger.', 'Tap only the louder ones, skip the rest.'] },
    twinstrike: { t: 'Twin Strike', d: ['Singles get one tap.', 'Doubles get two fast taps.'] },
    rampup: { t: 'Ramp Up', d: ['The tempo speeds up then slows.', 'Tap every beat through the curve.'] },
