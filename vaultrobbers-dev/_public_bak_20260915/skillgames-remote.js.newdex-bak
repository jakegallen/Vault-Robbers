  function pPinchGap(canvas, st) { const startBand = st.data.startBand || 0.4, endBand = st.data.endBand || 0.15, center = st.data.center || 0.5, dur = st.data.dur || 7000, centreAmp = st.data.centreAmp || 0, centreFx = st.data.centreFx || 0, centrePhase = st.data.centrePhase || 0;
    return _dxDrag(canvas, st, 'PINCH GAP', 'KEEP THE DOT INSIDE THE CLOSING BAND', function (g, w, h, t, cur, dragging) { const f = clamp(t / dur, 0, 1), half = (startBand + (endBand - startBand) * f) / 2; const cen = clamp(center + centreAmp * Math.sin(t * centreFx + centrePhase), 0.05, 0.95), cX = cen * w, hw = half * w;
