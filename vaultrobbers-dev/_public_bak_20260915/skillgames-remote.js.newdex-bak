      canvas.addEventListener('pointerdown', tap); fr(); }); }

  function pBeatRunner(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const notes = st.data.notes || [], lanes = st.data.lanes || 1, travel = st.data.travelMs || 1150, dur = st.data.dur || 6000, tol = st.data.tol || 170; const hitY = h - 70, topY = 40; const lx = i => (w * (i + 0.5) / lanes);
    return new Promise(res => { let raf, t0 = performance.now(), done = false; const fl = [];
      function fr() { const t = performance.now() - t0; bg(g, w, h); banner(g, w, 'BEAT RUNNER'); _ryBar(g, w, t, dur);
        for (let i = 0; i < lanes; i++) { g.strokeStyle = 'rgba(255,210,74,.10)'; g.lineWidth = 1; g.beginPath(); g.moveTo(lx(i), topY); g.lineTo(lx(i), hitY + 26); g.stroke(); }
        g.strokeStyle = 'rgba(125,208,255,.6)'; g.lineWidth = 3; g.beginPath(); g.moveTo(20, hitY); g.lineTo(w - 20, hitY); g.stroke();
        for (const n of notes) { const dt = n.t - t; if (dt > travel || dt < -260) continue; const y = topY + (1 - dt / travel) * (hitY - topY); const nr = Math.abs(dt) <= tol; g.save(); g.fillStyle = nr ? '#3dff8f' : '#ffd24a'; g.shadowColor = g.fillStyle; g.shadowBlur = nr ? 16 : 6; g.beginPath(); g.arc(lx(n.lane), y, 13, 0, TAU); g.fill(); g.restore(); }
        for (let i = fl.length - 1; i >= 0; i--) { const a = 1 - (t - fl[i].t) / 360; if (a <= 0) { fl.splice(i, 1); continue; } g.save(); g.globalAlpha = a * 0.3; g.fillStyle = fl[i].ok ? '#3dff8f' : '#ff5a3c'; g.beginPath(); g.arc(fl[i].x, hitY, 20 * (1 + (1 - a)), 0, TAU); g.fill(); g.restore(); }
        g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace"; g.fillText('TAP AS EACH NOTE HITS THE LINE', w / 2, h - 12);
        if (t >= dur && !done) { done = true; cleanup(); setTimeout(() => res(ev), 240); return; } if (!done) raf = requestAnimationFrame(fr); }
      function tap(e) { if (done) return; const t = Math.round(performance.now() - t0); ev.push({ type: 'tap', t }); let bd = 1e9; for (const n of notes) bd = Math.min(bd, Math.abs(n.t - t)); const ok = bd <= tol; const p = _pos(canvas, w, h, e); fl.push({ t: performance.now() - t0, ok, x: p.x * w }); try { sfx.lock(); } catch (e2) {} }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', tap); }
      canvas.addEventListener('pointerdown', tap); fr(); }); }

  function pMetroSwing(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const beats = st.data.beats || [], half = st.data.half || 600, dur = st.data.dur || 6000; const px = w / 2, py = 74, len = Math.min(h * 0.5, 210), tol = st.data.tol || 210;
    return new Promise(res => { let raf, t0 = performance.now(), done = false; const fl = [];
      const near = t => { let d = 1e9; for (const b of beats) d = Math.min(d, Math.abs(b - t)); return d; };
      function fr() { const t = performance.now() - t0; bg(g, w, h); banner(g, w, 'METRONOME SWING'); _ryBar(g, w, t, dur);
        const ang = 0.62 * Math.cos(Math.PI * (t - (beats[0] || 900)) / half); const bx = px + Math.sin(ang) * len, by = py + Math.cos(ang) * len;   // COS: the swing ENDS (where it turns) now land on the beats -> tap the ends, not the fast bottom (Jake 2026-09-12 fix)
        g.strokeStyle = 'rgba(255,210,74,.22)'; g.lineWidth = 2; g.beginPath(); g.moveTo(px, py); g.lineTo(px + Math.sin(0.62) * len, py + Math.cos(0.62) * len); g.moveTo(px, py); g.lineTo(px - Math.sin(0.62) * len, py + Math.cos(0.62) * len); g.stroke();
        const hot = near(t) < tol; g.strokeStyle = 'rgba(255,210,74,.5)'; g.lineWidth = 3; g.beginPath(); g.moveTo(px, py); g.lineTo(bx, by); g.stroke(); g.save(); g.fillStyle = hot ? '#3dff8f' : '#ffd24a'; g.shadowColor = g.fillStyle; g.shadowBlur = hot ? 18 : 8; g.beginPath(); g.arc(bx, by, 15, 0, TAU); g.fill(); g.restore();
