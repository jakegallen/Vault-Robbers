      g.strokeStyle = 'rgba(255,210,74,.25)'; g.lineWidth = 6; g.beginPath(); g.arc(cx, cy, R, 0, TAU); g.stroke();
      g.save(); g.strokeStyle = prog >= 1 ? '#3dff8f' : '#ffd24a'; g.shadowColor = g.strokeStyle; g.shadowBlur = 12; g.lineWidth = 6; g.beginPath(); g.arc(cx, cy, R, -Math.PI / 2, -Math.PI / 2 + prog * TAU); g.stroke(); g.restore();
      g.fillStyle = prog >= 1 ? '#3dff8f' : '#e6ddc8'; g.textAlign = 'center'; g.font = "700 20px 'Space Mono',monospace"; g.fillText(turned.toFixed(1) + '/' + turns, cx, cy + 7);
      if (dragging) { g.save(); g.fillStyle = '#7fd0ff'; g.shadowColor = '#7fd0ff'; g.shadowBlur = 10; g.beginPath(); g.arc(cur.x * w, cur.y * h, 8, 0, TAU); g.fill(); g.restore(); } }, dur); }

  function pTraceChase(canvas, st) { const path = st.data.path || [], dur = st.data.dur || 7000; const targetAt = t => { if (!path.length) return { x: 0.5, y: 0.5 }; if (t <= path[0].t) return path[0]; for (let i = 1; i < path.length; i++) { if (t <= path[i].t) { const a = path[i - 1], b = path[i], f = (t - a.t) / Math.max(1, b.t - a.t); return { x: a.x + (b.x - a.x) * f, y: a.y + (b.y - a.y) * f }; } } return path[path.length - 1]; };
    return _dxDrag(canvas, st, 'TRACE CHASE', 'KEEP YOUR CURSOR ON THE MOVING TARGET', function (g, w, h, t, cur, dragging) { const tg = targetAt(t); g.save(); g.strokeStyle = 'rgba(255,210,74,.6)'; g.lineWidth = 3; g.beginPath(); g.arc(tg.x * w, tg.y * h, 18, 0, TAU); g.stroke(); g.fillStyle = 'rgba(255,210,74,.3)'; g.beginPath(); g.arc(tg.x * w, tg.y * h, 8, 0, TAU); g.fill(); g.restore();
      if (dragging) { const dist = Math.hypot(cur.x - tg.x, cur.y - tg.y); g.save(); g.fillStyle = dist < 0.09 ? '#3dff8f' : (dist < 0.16 ? '#ffd24a' : '#ff5a3c'); g.shadowColor = g.fillStyle; g.shadowBlur = 12; g.beginPath(); g.arc(cur.x * w, cur.y * h, 9, 0, TAU); g.fill(); g.restore(); } }, dur); }

  function pZigZag(canvas, st) { const nodes = st.data.nodes || [], dur = st.data.dur || 6800;
    return _dxDrag(canvas, st, 'ZIG ZAG', 'FOLLOW THE SHARP ZIG-ZAG PATH', function (g, w, h, t, cur, dragging) { const y0 = 46, yh = h - 90; const px = n => 24 + n.x * (w - 48), py = n => y0 + n.y * yh;
      g.strokeStyle = 'rgba(255,210,74,.5)'; g.lineWidth = 5; g.lineJoin = 'round'; g.beginPath(); nodes.forEach((n, i) => { i ? g.lineTo(px(n), py(n)) : g.moveTo(px(n), py(n)); }); g.stroke();
      if (nodes.length) { const s = nodes[0], f = nodes[nodes.length - 1]; pathMark(g, px(s), py(s), 'START', '#7fd0ff', t, !dragging); pathMark(g, px(f), py(f), 'END', '#3dff8f', t, false); }
      if (dragging) { const X = 24 + cur.x * (w - 48), Y = y0 + cur.y * yh; let md = 1e9; for (let i = 0; i < nodes.length - 1; i++) { const ax = px(nodes[i]), ay = py(nodes[i]), bx = px(nodes[i + 1]), by = py(nodes[i + 1]); const vx = bx - ax, vy = by - ay, L2 = vx * vx + vy * vy || 1; let tt = clamp(((X - ax) * vx + (Y - ay) * vy) / L2, 0, 1); md = Math.min(md, Math.hypot(X - (ax + tt * vx), Y - (ay + tt * vy))); } const dev = md / yh; g.save(); g.fillStyle = dev < 0.05 ? '#3dff8f' : (dev < 0.11 ? '#ffd24a' : '#ff5a3c'); g.shadowColor = g.fillStyle; g.shadowBlur = 12; g.beginPath(); g.arc(X, Y, 8, 0, TAU); g.fill(); g.restore(); } }, dur); }

  function pThreadNeedle(canvas, st) { const rings = st.data.rings || [], dur = st.data.dur || 7000; let idx = 0;
    return _dxDrag(canvas, st, 'THREAD NEEDLE', 'DRAG ONE LINE THROUGH THE RINGS IN ORDER', function (g, w, h, t, cur, dragging) {
      g.save(); g.strokeStyle = 'rgba(127,208,255,.16)'; g.setLineDash([6, 6]); g.lineWidth = 2; g.beginPath(); rings.forEach((rr, i) => { const X = rr.x * w, Y = rr.y * h; i ? g.lineTo(X, Y) : g.moveTo(X, Y); }); g.stroke(); g.setLineDash([]); g.restore();
      if (dragging && idx < rings.length) { const ring = rings[idx]; if (Math.hypot(cur.x - ring.x, cur.y - ring.y) <= ring.r) { idx++; try { sfx.lock(); } catch (e) {} } }
      rings.forEach((ring, i) => { const done = i < idx, next = i === idx; g.save(); g.strokeStyle = done ? '#3dff8f' : (next ? '#ffd24a' : 'rgba(255,210,74,.35)'); g.shadowColor = g.strokeStyle; g.shadowBlur = next ? 14 : 0; g.lineWidth = next ? 4 : 3; g.beginPath(); g.arc(ring.x * w, ring.y * h, ring.r * Math.min(w, h), 0, TAU); g.stroke(); g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "700 11px 'Space Mono',monospace"; g.fillText(String(i + 1), ring.x * w, ring.y * h + 4); g.restore(); });
      if (rings.length) { if (idx === 0) pathMark(g, rings[0].x * w, rings[0].y * h - rings[0].r * Math.min(w, h), 'START', '#7fd0ff', t, !dragging); const lastR = rings[rings.length - 1]; pathMark(g, lastR.x * w, lastR.y * h + lastR.r * Math.min(w, h), idx >= rings.length ? 'DONE' : 'END', '#3dff8f', t, false); }
      if (dragging) { g.save(); g.fillStyle = '#7fd0ff'; g.shadowColor = '#7fd0ff'; g.shadowBlur = 10; g.beginPath(); g.arc(cur.x * w, cur.y * h, 7, 0, TAU); g.fill(); g.restore(); } }, dur); }

  function pSteadyHold(canvas, st) { const zone = st.data.zone || 0.16, amp = st.data.amp || 0.12, fx = st.data.fx || 0.0006, fy = st.data.fy || 0.0005, px = st.data.px || 0, py = st.data.py || 0, dur = st.data.dur || 7000;
    // The hold zone slowly WANDERS on the same seed path the server grades against (tx,ty). Keep the dot inside the moving zone.
    return _dxDrag(canvas, st, 'STEADY HOLD', 'KEEP THE DOT INSIDE THE DRIFTING ZONE', function (g, w, h, t, cur, dragging) { const tx = 0.5 + amp * Math.sin(t * fx + px), ty = 0.5 + amp * Math.sin(t * fy + py); const zx = tx * w, zy = ty * h;
      g.save(); g.strokeStyle = 'rgba(61,255,143,.4)'; g.lineWidth = 2; g.setLineDash([5, 4]); g.beginPath(); g.ellipse(zx, zy, zone * w, zone * h, 0, 0, TAU); g.stroke(); g.restore();
      g.save(); g.fillStyle = 'rgba(61,255,143,.6)'; g.beginPath(); g.arc(zx, zy, 4, 0, TAU); g.fill(); g.restore();
      if (dragging) { const inZ = Math.hypot(cur.x - tx, cur.y - ty) <= zone; g.save(); g.fillStyle = inZ ? '#3dff8f' : '#ff5a3c'; g.shadowColor = g.fillStyle; g.shadowBlur = 14; g.beginPath(); g.arc(cur.x * w, cur.y * h, 10, 0, TAU); g.fill(); g.restore(); } }, dur); }

  // Distinct from Gap Threader: SOLID blocks rain down in waves at scattered lanes; keep the dot in CLEAR space (not under any block).
  function pDodgeFall(canvas, st) { const blocks = st.data.blocks || [], fall = st.data.fall || 900, dur = st.data.dur || 6000;
    return _dxDrag(canvas, st, 'DODGE FALL', 'WEAVE TO CLEAR SPACE — DODGE THE FALLING BLOCKS', function (g, w, h, t, cur, dragging) { const dotY = h - 74, dx = cur.x * w;
      let danger = false;   // RED when a descending block is lined up with the dot's column near the bottom
      for (const bl of blocks) { const y = dotY * (1 - (bl.t - t) / fall); if (y < 16 || y > dotY + 24) continue; const bx = bl.x * w, bwx = bl.bw * w; const inCol = dx >= bx - bwx / 2 && dx <= bx + bwx / 2; if (inCol && Math.abs(y - dotY) < 26) danger = true; const threat = inCol && y > dotY - 120; g.save(); g.fillStyle = threat ? 'rgba(255,90,60,.92)' : 'rgba(200,90,70,.55)'; if (threat) { g.shadowColor = '#ff5a3c'; g.shadowBlur = 14; } roundRect(g, bx - bwx / 2, y - 12, bwx, 24, 5); g.fill(); g.restore(); }
      const col = danger ? '#ff5a3c' : '#3dff8f'; g.save(); g.fillStyle = col; g.shadowColor = col; g.shadowBlur = danger ? 12 + 8 * Math.abs(Math.sin(t / 90)) : 12; g.beginPath(); g.arc(dx, dotY, 11, 0, TAU); g.fill(); g.restore(); }, dur); }

  function pSwipeGates(canvas, st) { const gates = st.data.gates || [], dur = st.data.dur || 7000; const AR = { up: '↑', right: '→', down: '↓', left: '←' }; let idx = 0, anchor = null;
    return _dxDrag(canvas, st, 'SWIPE GATES', 'SWIPE THROUGH EACH GATE IN ORDER', function (g, w, h, t, cur, dragging) {
      if (dragging) { if (!anchor) anchor = { x: cur.x, y: cur.y }; else { const dx = cur.x - anchor.x, dy = cur.y - anchor.y; if (Math.hypot(dx, dy) >= 0.14) { let dir; if (Math.abs(dx) >= Math.abs(dy)) dir = dx > 0 ? 'right' : 'left'; else dir = dy > 0 ? 'down' : 'up'; if (idx < gates.length && dir === gates[idx]) { idx++; try { sfx.lock(); } catch (e) {} burst(cur.x * w, cur.y * h, '#3dff8f'); } anchor = { x: cur.x, y: cur.y }; } } } else anchor = null;
      const cy = h / 2 + 6, gw = (w - 40) / Math.max(1, gates.length); gates.forEach((gt, i) => { const X = 20 + (i + 0.5) * gw; const done = i < idx, next = i === idx; g.save(); g.fillStyle = done ? '#3dff8f' : (next ? '#ffd24a' : 'rgba(255,210,74,.35)'); g.shadowColor = g.fillStyle; g.shadowBlur = next ? 14 : 0; g.textAlign = 'center'; g.textBaseline = 'middle'; g.font = '700 34px sans-serif'; g.fillText(AR[gt] || '?', X, cy); g.restore(); });
      if (dragging) { g.save(); g.fillStyle = '#7fd0ff'; g.beginPath(); g.arc(cur.x * w, cur.y * h, 7, 0, TAU); g.fill(); g.restore(); } }, dur); }

  P.pulselock = pPulseLock; P.beatrunner = pBeatRunner; P.metroswing = pMetroSwing; P.echotap = pEchoTap; P.combochain = pComboChain;
  P.wiretrace = pWireTrace; P.gapthreader = pGapThreader; P.lasercorridor = pLaserCorridor; P.coilunwind = pCoilUnwind; P.tiltbalance = pTiltBalance;
  // NEW RHYTHM (10) — Jake 2026-09-12 expansion
  P.sustainhold = pSustainHold; P.offbeat = pOffBeat; P.accentonly = pAccentOnly; P.twinstrike = pTwinStrike; P.rampup = pRampUp;
  P.laneswitch = pLaneSwitch; P.echoreverse = pEchoReverse; P.gatepulse = pGatePulse; P.stepladder = pStepLadder; P.heartbeat = pHeartbeat;
  // NEW DEXTERITY (10) — Jake 2026-09-12 expansion (drag games reuse _dxDrag)
  P.mazerun = pMazeRun; P.orbitring = pOrbitRing; P.pinchgap = pPinchGap; P.cranklever = pCrankLever; P.tracechase = pTraceChase;
  P.zigzag = pZigZag; P.threadneedle = pThreadNeedle; P.steadyhold = pSteadyHold; P.dodgefall = pDodgeFall; P.swipegates = pSwipeGates;

  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
  // ── SKILL V4 presenters (Jake 2026-09-12): PRECISE DISCRETE EXECUTION UNDER UNCERTAINTY. Client-drawn (no server PNG); each
  //    returns an events array the SERVER grades against its own secret. REACTION games reveal the go-cue at the server-random time
  //    shipped in data and the server rejects taps <110ms after it (pre-fire); SEQUENCE games react to presses; CHARGE/AIM commit
  //    a value under live feedback. Display data rides in `data` (mirrors the rhythm/dexterity presenters), grading keys in `secret`.
  // ══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
  const RXCOLD = '#7d94a6', RXHOT = '#3dff8f', RXRED = '#ff5a3c', RXAMB = '#ffd24a';
  function _rxTimeBar(g, w, t, dur) { const bw = Math.min(w * 0.6, 280), bx = (w - bw) / 2, tl = clamp(1 - t / dur, 0, 1); g.fillStyle = 'rgba(8,12,10,.8)'; roundRect(g, bx, 26, bw, 6, 3); g.fill(); g.save(); g.fillStyle = tl < 0.28 ? RXRED : (tl < 0.55 ? RXAMB : RXHOT); roundRect(g, bx, 26, bw * tl, 6, 3); g.fill(); g.restore(); }

  // grid geometry helper for the pad/glyph grids (gonogo/oddsignal). Returns {cellW,cellH,x0,y0,gx,gy,idxAt}.
  function _rxGrid(w, h, cols, rows) { const padX = 24, top = 96, bot = 44; const gw = w - padX * 2, gh = h - top - bot; const cellW = gw / cols, cellH = gh / rows;
    const gx = i => padX + (i % cols) * cellW + cellW / 2, gy = i => top + Math.floor(i / cols) * cellH + cellH / 2;
    const idxAt = (px, py) => { if (px < padX || px > w - padX || py < top || py > h - bot) return -1; const c = Math.floor((px - padX) / cellW), rIdx = Math.floor((py - top) / cellH); if (c < 0 || c >= cols || rIdx < 0 || rIdx >= rows) return -1; return rIdx * cols + c; };
    return { cellW, cellH, gx, gy, idxAt, r: Math.min(cellW, cellH) * 0.36 }; }
  // small glyph library for the visual-search game (drawn at (cx,cy), radius R, rotation quarter-turns).
  function _rxGlyph(g, cx, cy, R, shape, rot) { g.save(); g.translate(cx, cy); g.rotate(rot * Math.PI / 2); g.beginPath();
    switch (shape % 6) {
      case 0: g.moveTo(0, -R); g.lineTo(R, R); g.lineTo(-R, R); g.closePath(); break;                 // triangle
      case 1: g.rect(-R * 0.82, -R * 0.82, R * 1.64, R * 1.64); break;                                  // square
      case 2: g.arc(0, 0, R * 0.9, 0, TAU); break;                                                      // circle
      case 3: for (let i = 0; i < 5; i++) { const a = -Math.PI / 2 + i * TAU / 5; const fn = i ? 'lineTo' : 'moveTo'; g[fn](Math.cos(a) * R, Math.sin(a) * R); } g.closePath(); break;   // pentagon
      case 4: g.moveTo(0, -R); g.lineTo(R, 0); g.lineTo(0, R); g.lineTo(-R, 0); g.closePath(); break;   // diamond
      default: g.moveTo(-R, -R * 0.5); g.lineTo(R, -R * 0.5); g.lineTo(0, R); g.closePath(); break;      // wedge
    } g.fill(); g.restore(); }

  // ── REACTION anti-leak: 300-space layouts that MIRROR render.js (rxGridLayout / rxPadLayout). The served answer PNG is drawn full-bleed
  //    into the play area (0,30)-(w,h); a client tap is mapped back to 300-space so its cell/pad index matches the served pixel exactly.
  function _c2s(canvas, w, h, e) { const r = canvas.getBoundingClientRect(); const px = (e.clientX - r.left) * (w / r.width), py = (e.clientY - r.top) * (h / r.height); return { sx: px / w * 300, sy: (py - 30) / (h - 30) * 300, px, py }; }
  function rxGridLayout300(cols, rows) { const padX = 24, top = 40, bot = 30; const gw = 300 - padX * 2, gh = 300 - top - bot; const cellW = gw / cols, cellH = gh / rows;
    return { idxAt: (sx, sy) => { if (sx < padX || sx > 300 - padX || sy < top || sy > 300 - bot) return -1; const c = Math.floor((sx - padX) / cellW), rr = Math.floor((sy - top) / cellH); if (c < 0 || c >= cols || rr < 0 || rr >= rows) return -1; return rr * cols + c; } }; }
  function rxPadLayout300(pads) { const marginX = 20, ph = 64, y = 300 - 104, pwFull = (300 - marginX * 2) / pads; return { idxAt: (sx, sy) => { if (sy < y - 6 || sy > y + ph + 6) return -1; let idx = Math.floor((sx - marginX) / pwFull); return Math.max(0, Math.min(pads - 1, idx)); } }; }
  // draw the served answer frame full-bleed into the play area (matches drawFrame's (0,30) origin)
  function _drawServed(g, img, w, h) { g.drawImage(img, 0, 30, w, h - 30); }

  // 1) GO / NO-GO (INHIBITION) — the board lights at once (SERVED frame, answer never in data): tap every GREEN pad, never a red/off-green.
  function pGoNoGo(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const cols = st.data.cols || 3, rows = st.data.rows || 2, cells = st.data.cells || cols * rows, revealT = st.data.revealT || 1200, dur = st.data.dur || 5000; const needed = st.data.nGo || 1;
    const L = rxGridLayout300(cols, rows); const cellW = (300 - 48) / cols, cellH = (300 - 70) / rows, R = Math.min(cellW, cellH) * 0.36;
    const cx300 = (i) => 24 + (i % cols) * cellW + cellW / 2, cy300 = (i) => 40 + Math.floor(i / cols) * cellH + cellH / 2;
    // client<->300 mappers for burst placement
    const sx2c = (sx) => sx / 300 * w, sy2c = (sy) => 30 + sy / 300 * (h - 30);
    return new Promise(res => { let raf, t0 = performance.now(), done = false, finishAt = 0, resultTxt = '', boardImg = null, fetching = false; const tapped = new Set();
      function fr() { const t = performance.now() - t0; bg(g, w, h); banner(g, w, 'GO / NO-GO'); _rxTimeBar(g, w, t, dur); const shown = t >= revealT;
        if (shown && !boardImg && !fetching) { fetching = true; loadImg(FU(st, 0)).then(im => { boardImg = im; }).catch(() => { fetching = false; }); }
        if (!shown || !boardImg) { for (let i = 0; i < cells; i++) { const cx = sx2c(cx300(i)), cy = sy2c(cy300(i)), Rr = R / 300 * w; g.save(); g.fillStyle = 'rgba(60,72,66,.45)'; roundRect(g, cx - Rr, cy - Rr, Rr * 2, Rr * 2, 10); g.fill(); g.restore(); } }
        else { _drawServed(g, boardImg, w, h); for (const i of tapped) { const cx = sx2c(cx300(i)), cy = sy2c(cy300(i)); g.save(); g.fillStyle = 'rgba(4,18,26,.55)'; const Rr = R / 300 * w; roundRect(g, cx - Rr, cy - Rr, Rr * 2, Rr * 2, 10); g.fill(); g.fillStyle = '#eafff3'; g.textAlign = 'center'; g.textBaseline = 'middle'; g.font = "800 22px 'Chakra Petch',sans-serif"; g.fillText('✓', cx, cy); g.textBaseline = 'alphabetic'; g.restore(); } }
        g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace"; g.fillText(shown ? 'TAP ONLY TRUE GREEN, NOT THE OFF-GREENS OR REDS' : 'WATCH THE BOARD…', w / 2, h - 14);
        if (resultTxt) { g.save(); g.fillStyle = resultTxt[0] === 'R' ? RXRED : RXHOT; g.shadowColor = g.fillStyle; g.shadowBlur = 16; g.textAlign = 'center'; g.font = "800 22px 'Chakra Petch',sans-serif"; g.fillText(resultTxt, w / 2, 58); g.restore(); }
        if (finishAt && t >= finishAt && !done) { done = true; cleanup(); res(ev); return; }
        if (t >= dur && !done) { done = true; cleanup(); setTimeout(() => res(ev), 220); return; } if (!done) raf = requestAnimationFrame(fr); }
      function tap(e) { if (done || finishAt) return; const t = Math.round(performance.now() - t0); const s = _c2s(canvas, w, h, e); const idx = L.idxAt(s.sx, s.sy); if (idx < 0) return; if (tapped.has(idx)) return; ev.push({ type: 'tap', t, idx });
        // client can't know green vs red (answer is server-only). Reflect a neutral tap; the SERVER grades. Once nGo distinct taps land, finish.
        tapped.add(idx); try { sfx.lock(); } catch (e2) {} burst(s.px, s.py, RXHOT); if (tapped.size >= needed) { resultTxt = 'LOCKED IN'; finishAt = (performance.now() - t0) + 460; } }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', tap); }
      canvas.addEventListener('pointerdown', tap); fr(); }); }

  // 2) ODD SIGNAL (VISUAL SEARCH) — the glyph FIELD reveals (SERVED frame, answer never in data); find and tap the odd one out.
  function pOddSignal(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const cols = st.data.cols || 3, rows = st.data.rows || 3, revealT = st.data.revealT || 1200, dur = st.data.dur || 3000;
    const L = rxGridLayout300(cols, rows);
    return new Promise(res => { let raf, t0 = performance.now(), done = false, fieldImg = null, fetching = false;
      function fr() { const t = performance.now() - t0; bg(g, w, h); banner(g, w, 'ODD SIGNAL'); _rxTimeBar(g, w, t, dur); const shown = t >= revealT;
        if (shown && !fieldImg && !fetching) { fetching = true; loadImg(FU(st, 0)).then(im => { fieldImg = im; }).catch(() => { fetching = false; }); }
        if (shown && fieldImg) { _drawServed(g, fieldImg, w, h); } else { g.save(); g.fillStyle = 'rgba(60,72,66,.4)'; g.textAlign = 'center'; g.font = "700 16px 'Space Mono',monospace"; g.fillStyle = '#5a6b60'; g.fillText('WATCH THE FIELD…', w / 2, h / 2); g.restore(); }
        g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace"; g.fillText(shown ? 'FIND AND TAP THE ODD ONE OUT' : 'WATCH THE FIELD…', w / 2, h - 14);
        if (t >= dur && !done) { done = true; cleanup(); setTimeout(() => res(ev), 220); return; } if (!done) raf = requestAnimationFrame(fr); }
      function tap(e) { if (done) return; const t = Math.round(performance.now() - t0); const s = _c2s(canvas, w, h, e); const idx = L.idxAt(s.sx, s.sy); if (idx < 0) return; ev.push({ type: 'tap', t, idx }); try { sfx.lock(); } catch (e2) {} burst(s.px, s.py, ACC); done = true; cleanup(); setTimeout(() => res(ev), 260); }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', tap); }
      canvas.addEventListener('pointerdown', tap); fr(); }); }

  // 3) TRAPDOOR (TARGET DISCRIMINATION) — a target swatch is shown; a row of coloured pads ARMS at a random instant; tap the pad matching
  //    the target. Tapping a decoy pad, or firing before the arm, fails. DEEP the round repeats (2-stage confirm) with a fresh target.
  const RXPAL = ['#ff5a3c', '#3dff8f', '#7fd0ff', '#ffd24a', '#c874ff'];   // pad colour palette (index -> hex)
  function pTrapdoor(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const dur = st.data.dur || 3000, pads = st.data.pads || 4; const stages = st.data.stages || [{ goTime: st.data.goTime || 1500 }]; const rounds = stages.length;
    const L = rxPadLayout300(pads); const stImgs = new Array(rounds).fill(null); const fetchingStage = new Array(rounds).fill(false);
    return new Promise(res => { let raf, t0 = performance.now(), done = false; const tappedStage = new Array(rounds).fill(false);
      function curStage(t) { let idx = 0; for (let i = 0; i < stages.length; i++) if (t >= stages[i].goTime - 900) idx = i; return idx; }
      function fr() { const t = performance.now() - t0; bg(g, w, h); banner(g, w, 'TRAPDOOR'); _rxTimeBar(g, w, t, dur); const si = curStage(t); const S = stages[si]; const armed = t >= S.goTime;
        if (armed && !stImgs[si] && !fetchingStage[si]) { fetchingStage[si] = true; loadImg(FU(st, si)).then(im => { stImgs[si] = im; }).catch(() => { fetchingStage[si] = false; }); }
        if (armed && stImgs[si]) { _drawServed(g, stImgs[si], w, h); }
        else { g.save(); g.textAlign = 'center'; g.fillStyle = '#8a9a8f'; g.font = "12px 'Space Mono',monospace"; g.fillText('MATCH THIS COLOUR' + (rounds > 1 ? '  (' + (si + 1) + '/' + rounds + ')' : ''), w / 2, h / 2 - 58); g.restore();
          const pyC = 30 + (300 - 104) / 300 * (h - 30), pwC = (w - 40) / pads; for (let i = 0; i < pads; i++) { const x = 20 + i * pwC; g.save(); g.fillStyle = 'rgba(60,72,66,.5)'; roundRect(g, x + 4, pyC, pwC - 8, 64 / 300 * (h - 30), 10); g.fill(); g.restore(); } }
        g.fillStyle = armed ? '#3dff8f' : '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace"; g.fillText(armed ? 'TAP THE PAD THAT MATCHES THE TARGET' : 'WAIT FOR THE PADS TO ARM…', w / 2, h - 14);
        if (t >= dur && !done) { done = true; cleanup(); setTimeout(() => res(ev), 220); return; } if (!done) raf = requestAnimationFrame(fr); }
      function tap(e) { if (done) return; const t = Math.round(performance.now() - t0); const si = curStage(t); if (tappedStage[si]) return; const S = stages[si]; const s = _c2s(canvas, w, h, e); const idx = L.idxAt(s.sx, s.sy); if (idx < 0) return; ev.push({ type: 'tap', t, idx }); tappedStage[si] = true; try { sfx.lock(); } catch (e2) {} burst(s.px, s.py, ACC); if (si >= rounds - 1) { done = true; cleanup(); setTimeout(() => res(ev), 240); } }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', tap); }
      canvas.addEventListener('pointerdown', tap); fr(); }); }

  // 4) COLOUR CALL (FINE-SHADE) — a called colour swatch appears; hit the pad whose EXACT shade matches. One decoy pad is a near-match of
  //    the same hue family (subtly different shade) — read the shade, not just the coarse colour.
  // base hue families as RGB triples; a shade in [0..1] darkens (light -> deep) the family colour.
  function pColourCall(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const pads = st.data.pads || 4, dur = st.data.dur || 3000;
    const stages = st.data.stages || [{ cueT: st.data.cueT || 1200 }]; const rounds = stages.length;
    const L = rxPadLayout300(pads); const stImgs = new Array(rounds).fill(null); const fetchingStage = new Array(rounds).fill(false);
    return new Promise(res => { let raf, t0 = performance.now(), done = false; const tappedStage = new Array(rounds).fill(false);
      function curStage(t) { let idx = 0; for (let i = 0; i < stages.length; i++) if (t >= stages[i].cueT - 900) idx = i; return idx; }
      function fr() { const t = performance.now() - t0; bg(g, w, h); banner(g, w, 'COLOUR CALL'); _rxTimeBar(g, w, t, dur); const si = curStage(t); const S = stages[si]; const called = t >= S.cueT;
        if (called && !stImgs[si] && !fetchingStage[si]) { fetchingStage[si] = true; loadImg(FU(st, si)).then(im => { stImgs[si] = im; }).catch(() => { fetchingStage[si] = false; }); }
        if (called && stImgs[si]) { _drawServed(g, stImgs[si], w, h); }
        else { g.save(); g.textAlign = 'center'; g.fillStyle = '#5a6b60'; g.font = "700 18px 'Space Mono',monospace"; g.fillText('READY', w / 2, h / 2 - 30); g.restore(); }
        g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace"; g.fillText('HIT THE PAD WHOSE SHADE MATCHES', w / 2, h - 14);
        if (t >= dur && !done) { done = true; cleanup(); setTimeout(() => res(ev), 220); return; } if (!done) raf = requestAnimationFrame(fr); }
      function tap(e) { if (done) return; const t = Math.round(performance.now() - t0); const si = curStage(t); if (tappedStage[si]) return; const s = _c2s(canvas, w, h, e); const idx = L.idxAt(s.sx, s.sy); if (idx < 0) return; ev.push({ type: 'tap', t, idx }); tappedStage[si] = true; try { sfx.lock(); } catch (e2) {} burst(s.px, s.py, ACC); if (si >= rounds - 1) { done = true; cleanup(); setTimeout(() => res(ev), 240); } }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', tap); }
      canvas.addEventListener('pointerdown', tap); fr(); }); }

  // 5) TWITCH RELEASE (TRUE-CUE) — hold; the panel throws AMBER fake-out flashes; release only on the TRUE GREEN flip.
  function pTwitchRelease(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const flipT = st.data.flipT || 1500, dur = st.data.dur || 3000, decoys = st.data.decoys || [], decoyReject = st.data.decoyReject || 200; const cx = w / 2, cy = h / 2 + 6;
    return new Promise(res => { let raf, t0 = performance.now(), done = false, holding = false;
      function fr() { const t = performance.now() - t0; bg(g, w, h); banner(g, w, 'TWITCH RELEASE'); _rxTimeBar(g, w, t, dur); const flipped = t >= flipT;
        // is a fake-out amber flash active right now?
        let decoyOn = false; for (const dcy of decoys) { if (t >= dcy && t < dcy + 180) { decoyOn = true; break; } }
        g.save(); let col; if (!holding) col = '#5a6b60'; else if (flipped) col = RXHOT; else if (decoyOn) col = RXAMB; else col = '#2f6a4a'; g.fillStyle = col; g.shadowColor = col; g.shadowBlur = holding && (flipped || decoyOn) ? 26 : (holding ? 10 : 0); roundRect(g, cx - 70, cy - 44, 140, 88, 14); g.fill(); g.restore();
        g.fillStyle = '#04121a'; g.textAlign = 'center'; g.textBaseline = 'middle'; g.font = "800 17px 'Chakra Petch',sans-serif"; g.fillText(!holding ? 'HOLD' : (flipped ? 'RELEASE!' : (decoyOn ? 'FAKE, HOLD' : 'HOLD…')), cx, cy); g.textBaseline = 'alphabetic';
        g.fillStyle = '#8a9a8f'; g.font = "12px 'Space Mono',monospace"; g.fillText('IGNORE AMBER FAKE-OUTS, RELEASE ON GREEN', cx, h - 14);
        if (t >= dur && !done) { done = true; cleanup(); setTimeout(() => res(ev), 220); return; } if (!done) raf = requestAnimationFrame(fr); }
      function down() { if (done || holding) return; holding = true; ev.push({ type: 'down', t: Math.round(performance.now() - t0) }); try { sfx.whir(); } catch (e) {} }
      function up() { if (done || !holding) return; const t = Math.round(performance.now() - t0); ev.push({ type: 'up', t }); try { sfx.lock(); } catch (e) {} let onDecoy = false; for (const dcy of decoys) { if (Math.abs(t - dcy) <= decoyReject) onDecoy = true; } const ok = t >= flipT - decoyReject && !onDecoy; burst(cx, cy, ok ? RXHOT : RXRED); if (!ok) shake(canvas, 6); done = true; cleanup(); setTimeout(() => res(ev), 240); }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', down); canvas.removeEventListener('pointerup', up); canvas.removeEventListener('pointerleave', up); }
      canvas.addEventListener('pointerdown', down); canvas.addEventListener('pointerup', up); canvas.addEventListener('pointerleave', up); fr(); }); }

  // Shared 4-direction pad (up/right/down/left) for sequence games. onPress(id) called with 0..3.
  function _dirPad(g, w, h, onGeom) { const cx = w / 2, cy = h - 118, s = 42; const cells = [{ id: 0, x: cx, y: cy - s, ch: '↑' }, { id: 1, x: cx + s, y: cy, ch: '→' }, { id: 2, x: cx, y: cy + s, ch: '↓' }, { id: 3, x: cx - s, y: cy, ch: '←' }]; cells.forEach(c => { g.save(); g.fillStyle = 'rgba(255,210,74,.14)'; roundRect(g, c.x - 26, c.y - 26, 52, 52, 9); g.fill(); g.strokeStyle = 'rgba(255,210,74,.4)'; g.lineWidth = 1.5; roundRect(g, c.x - 26, c.y - 26, 52, 52, 9); g.stroke(); g.fillStyle = '#ffd9a0'; g.textAlign = 'center'; g.textBaseline = 'middle'; g.font = '700 26px sans-serif'; g.fillText(c.ch, c.x, c.y); g.restore(); }); g.textBaseline = 'alphabetic'; if (onGeom) onGeom(cells); return cells; }
  function _hitDirPad(canvas, w, h, e, cells) { const r = canvas.getBoundingClientRect(); const px = (e.clientX - r.left) * (w / r.width), py = (e.clientY - r.top) * (h / r.height); for (const c of cells) { if (px >= c.x - 26 && px <= c.x + 26 && py >= c.y - 26 && py <= c.y + 26) return c.id; } return -1; }
  const _ARROW = ['↑', '→', '↓', '←'];

  // 6) SAFE PROCEDURE — a short directional sequence flashes, then input it under a deadline.
  async function pSafeProc(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const n = st.data.n || 4; const showMs = st.data.showMs || 1500, deadline = st.data.deadline || 3000, decoys = st.data.decoys || []; const dur = st.data.dur || 5000;
    // ANTI-LEAK (skill-harden 2026-09-14): the arrow procedure is a SERVER PNG served ONCE via the v4frame one-shot transport (answer is
    // NEVER in st.data). Fetch it up front; the flash below draws the image. ROBUSTNESS: if it fails to load, `procImg` stays null and the
    // show phase falls back to a neutral "MEMORISE" prompt — the player still gets the full input phase and can attempt; we NEVER auto-zero.
    let procImg = null; try { procImg = await loadImg(FU(st, 0)); } catch (e) { procImg = null; }
    return new Promise(res => { let raf, t0 = performance.now(), done = false; let cells = []; let flash = { id: -1, t: -1e9 }; const entered = [];
      function fr() { const t = performance.now() - t0; bg(g, w, h); banner(g, w, 'SAFE PROCEDURE'); const showing = t < showMs;
        if (showing) { if (procImg) { drawFrame(g, procImg, w, h); } else { g.fillStyle = RXAMB; g.textAlign = 'center'; g.font = "700 22px 'Space Mono',monospace"; g.fillText('MEMORISE THE PROCEDURE', w / 2, h / 2); }
          // DECOY flashes (draw-only mislead): a stray arrow blips top/bottom for ~220ms, NOT part of the real procedure. Grade ignores these.
          for (const dc of decoys) { if (t >= dc.at && t < dc.at + 220) { const a = 1 - (t - dc.at) / 220; g.save(); g.globalAlpha = 0.5 * a; g.fillStyle = '#ff5a3c'; g.textAlign = 'center'; g.font = "700 30px sans-serif"; g.fillText(_ARROW[dc.id], w * (0.2 + 0.6 * ((dc.at % 100) / 100)), t % 2 ? h * 0.30 : h * 0.70); g.restore(); } }
          g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace"; g.fillText('MEMORISE THE PROCEDURE (IGNORE RED BLIPS)', w / 2, h - 14); }
        else { const el = t - showMs, rem = clamp(1 - el / deadline, 0, 1); g.fillStyle = RXHOT; g.textAlign = 'center'; g.font = "700 15px 'Space Mono',monospace"; g.fillText('INPUT ' + ev.length + '/' + n, w / 2, 56); g.fillStyle = 'rgba(255,255,255,.08)'; g.fillRect(20, 66, w - 40, 4); g.fillStyle = rem < 0.3 ? RXRED : RXHOT; g.fillRect(20, 66, (w - 40) * rem, 4); cells = _dirPad(g, w, h); for (const c of cells) { if (c.id === flash.id && t - flash.t < 260) { const a = 1 - (t - flash.t) / 260; g.save(); g.globalAlpha = 0.35 + 0.5 * a; g.fillStyle = RXHOT; g.shadowColor = RXHOT; g.shadowBlur = 20; roundRect(g, c.x - 26, c.y - 26, 52, 52, 9); g.fill(); g.restore(); } } if (entered.length) { g.save(); g.fillStyle = RXHOT; g.textAlign = 'center'; g.font = '700 26px sans-serif'; g.fillText(entered.map(d => _ARROW[d]).join('  '), w / 2, 98); g.restore(); } g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace"; g.fillText('PUNCH IT BACK IN ORDER', w / 2, h - 14); if (el >= deadline && !done) { done = true; cleanup(); setTimeout(() => res(ev), 200); return; } }
        if (t >= dur && !done) { done = true; cleanup(); setTimeout(() => res(ev), 200); return; } if (!done) raf = requestAnimationFrame(fr); }
      function tap(e) { if (done) return; const t = performance.now() - t0; if (t < showMs) return; const id = _hitDirPad(canvas, w, h, e, cells); if (id < 0) return; ev.push({ type: 'press', id, t: Math.round(t) }); flash = { id, t }; entered.push(id); const cc = cells.find(c => c.id === id); if (cc) burst(cc.x, cc.y, RXHOT); try { sfx.click(); } catch (e2) {} if (ev.length >= n) { done = true; cleanup(); setTimeout(() => res(ev), 220); } }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', tap); }
      canvas.addEventListener('pointerdown', tap); fr(); }); }

  // 7) LOCK ORDER — the arm-order flashes ONCE (server PNG), then hit the locks in that remembered order.
  // ANTI-LEAK + ROBUST redesign (skill-harden 2026-09-14): the answer `order` is NEVER in st.data. The full order flashes as a SERVER PNG
  // served ONCE via the v4frame one-shot transport (each lock stamped with its 1..n step badge). The player memorises it, then taps the k
  // locks in that order. This replaces the fragile reactive per-step stream that once returned empty and bricked the game. ROBUSTNESS: if the
  // flash frame fails to load, we still run the full input phase (player attempts from memory / degraded) — we NEVER auto-zero.
  async function pLockOrder(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const k = st.data.k || 5, n = st.data.n || 3, showMs = st.data.showMs || 1800, dur = st.data.dur || 6000;
    let ordImg = null; try { ordImg = await loadImg(FU(st, 0)); } catch (e) { ordImg = null; }
    return new Promise(res => { let raf, t0 = performance.now(), done = false; const y = h / 2 + 6, gap = Math.min((w - 40) / k, 84), x0 = (w - gap * (k - 1)) / 2; let flash = { id: -1, t: -1e9 }; const tapped = [];
      function fr() { const t = performance.now() - t0; bg(g, w, h); banner(g, w, 'LOCK ORDER'); const showing = t < showMs;
        if (showing) { if (ordImg) { drawFrame(g, ordImg, w, h); } else { g.fillStyle = RXAMB; g.textAlign = 'center'; g.font = "700 20px 'Space Mono',monospace"; g.fillText('MEMORISE THE ORDER', w / 2, h / 2); }
          const rem = clamp(1 - t / showMs, 0, 1); g.fillStyle = 'rgba(255,255,255,.08)'; g.fillRect(20, 40, w - 40, 4); g.fillStyle = RXAMB; g.fillRect(20, 40, (w - 40) * rem, 4);
          g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace"; g.fillText('REMEMBER THE NUMBERED ORDER', w / 2, h - 14); }
        else { for (let i = 0; i < k; i++) { const X = x0 + i * gap; const lit = i === flash.id && t - flash.t < 260; g.save(); if (lit) { g.fillStyle = RXHOT; g.shadowColor = RXHOT; g.shadowBlur = 22; } else { g.fillStyle = RXCOLD; } g.beginPath(); g.arc(X, y, 22, 0, TAU); g.fill(); g.restore(); }
          g.fillStyle = RXHOT; g.textAlign = 'center'; g.font = "700 14px 'Space Mono',monospace"; g.fillText(tapped.length + '/' + n, w / 2, 56);
          g.fillStyle = '#8a9a8f'; g.font = "12px 'Space Mono',monospace"; g.fillText('HIT THE LOCKS IN THE ORDER YOU SAW', w / 2, h - 14); }
        if ((tapped.length >= n || t >= dur) && !done) { done = true; cleanup(); setTimeout(() => res(ev), 220); return; } if (!done) raf = requestAnimationFrame(fr); }
      function tap(e) { if (done) return; const t = Math.round(performance.now() - t0); if (t < showMs) return; if (tapped.length >= n) return; const r = canvas.getBoundingClientRect(), px = (e.clientX - r.left) * (w / r.width); let idx = Math.round((px - x0) / gap); idx = Math.max(0, Math.min(k - 1, idx));
        // Emit EVERY tap in order (client no longer knows `order`, so it can't self-validate). The SERVER grades the positional prefix; the
        // exact-count gate means we cap at n taps. flash the tapped lock so the player sees their input register.
        ev.push({ type: 'press', id: idx, t }); tapped.push(idx); flash = { id: idx, t: performance.now() - t0 }; try { sfx.lock(); } catch (e2) {} burst(x0 + idx * gap, y, RXHOT);
        if (tapped.length >= n) { done = true; cleanup(); setTimeout(() => res(ev), 260); } }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', tap); }
      canvas.addEventListener('pointerdown', tap); fr(); }); }

  // 8) COUNTER-ROTATE — alternate LEFT/RIGHT taps as the cadence rises.
  function pCounterRot(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const target = st.data.target || 14, startSide = st.data.startSide | 0, dur = st.data.dur || 12000;
    return new Promise(res => { let raf, t0 = performance.now(), done = false, streak = 0, side = startSide;
      function fr() { const t = performance.now() - t0; bg(g, w, h); banner(g, w, 'COUNTER-ROTATE'); _rxTimeBar(g, w, t, dur);
        const cy = h / 2 + 6; [0, 1].forEach(s => { const X = s === 0 ? w * 0.28 : w * 0.72; const nextSide = side; g.save(); g.fillStyle = s === nextSide ? RXHOT : RXCOLD; if (s === nextSide) { g.shadowColor = RXHOT; g.shadowBlur = 18; } g.beginPath(); g.arc(X, cy, 40, 0, TAU); g.fill(); g.restore(); g.fillStyle = '#04121a'; g.textAlign = 'center'; g.textBaseline = 'middle'; g.font = '700 26px sans-serif'; g.fillText(s === 0 ? '←' : '→', X, cy); g.textBaseline = 'alphabetic'; });
        g.fillStyle = streak > 0 ? RXHOT : '#8a9a8f'; g.textAlign = 'center'; g.font = "700 26px 'Space Mono',monospace"; g.fillText(streak + '/' + target, w / 2, 62);
        g.fillStyle = '#8a9a8f'; g.font = "12px 'Space Mono',monospace"; g.fillText('ALTERNATE, KEEP THE CHAIN ALIVE', w / 2, h - 14);
        if ((streak >= target || t >= dur) && !done) { done = true; cleanup(); setTimeout(() => res(ev), 220); return; } if (!done) raf = requestAnimationFrame(fr); }
      function tap(e) { if (done) return; const t = Math.round(performance.now() - t0); const r = canvas.getBoundingClientRect(), px = (e.clientX - r.left) * (w / r.width); const id = px < w / 2 ? 0 : 1; ev.push({ type: 'press', id, t }); if (id === side) { streak++; side = 1 - side; try { sfx.lock(); } catch (e2) {} burst(id === 0 ? w * 0.28 : w * 0.72, h / 2 + 6, RXHOT); } else { streak = 0; side = startSide; try { sfx.bust(); } catch (e2) {} shake(canvas, 5); } }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', tap); }
      canvas.addEventListener('pointerdown', tap); fr(); }); }

  // 9) REPEAT COMBO — an icon combo flashes; repeat it fast.
  function pRepeatCombo(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const icons = st.data.icons || 4, n = st.data.n || 4, combo = st.data.combo || [], flashMs = st.data.flashMs || 400, deadline = st.data.deadline || 3000, dur = st.data.dur || 5000;
    const GLY = ['◆', '●', '▲', '■', '★', '✚'], GC = ['#ff5a3c', '#3dff8f', '#7fd0ff', '#ffd24a', '#c78cff', '#ff9ad2'];
    return new Promise(res => { let raf, t0 = performance.now(), done = false, flash = { id: -1, t: -1e9 }; const entered = []; const flashPhase = n * (flashMs + 160);
      function fr() { const t = performance.now() - t0; bg(g, w, h); banner(g, w, 'REPEAT COMBO'); const inShow = t < flashPhase;
        if (inShow) { const i = Math.floor(t / (flashMs + 160)); const onNow = (t % (flashMs + 160)) < flashMs; if (i < n && onNow) { g.save(); g.fillStyle = GC[combo[i] % GC.length]; g.shadowColor = g.fillStyle; g.shadowBlur = 26; g.textAlign = 'center'; g.textBaseline = 'middle'; g.font = "700 66px sans-serif"; g.fillText(GLY[combo[i] % GLY.length], w / 2, h / 2 - 10); g.restore(); g.textBaseline = 'alphabetic'; } g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace"; g.fillText('WATCH THE COMBO', w / 2, h - 14); }
        else { const el = t - flashPhase, rem = clamp(1 - el / deadline, 0, 1); g.fillStyle = RXHOT; g.textAlign = 'center'; g.font = "700 14px 'Space Mono',monospace"; g.fillText('REPEAT ' + ev.length + '/' + n, w / 2, 56); g.fillStyle = 'rgba(255,255,255,.08)'; g.fillRect(20, 66, w - 40, 4); g.fillStyle = rem < 0.3 ? RXRED : RXHOT; g.fillRect(20, 66, (w - 40) * rem, 4);
          const pw = (w - 40) / icons, py = h - 96; for (let i = 0; i < icons; i++) { const x = 20 + i * pw; g.save(); g.fillStyle = GC[i % GC.length]; g.globalAlpha = 0.9; roundRect(g, x + 4, py, pw - 8, 60, 10); g.fill(); g.restore(); g.fillStyle = '#04121a'; g.textAlign = 'center'; g.textBaseline = 'middle'; g.font = '700 26px sans-serif'; g.fillText(GLY[i % GLY.length], x + pw / 2, py + 30); g.textBaseline = 'alphabetic'; }
          if (flash.id >= 0 && t - flash.t < 260) { const x = 20 + flash.id * pw, a = 1 - (t - flash.t) / 260; g.save(); g.globalAlpha = 0.5 + 0.5 * a; g.strokeStyle = '#fff'; g.lineWidth = 4; g.shadowColor = '#fff'; g.shadowBlur = 16; roundRect(g, x + 4, py, pw - 8, 60, 10); g.stroke(); g.restore(); }
          if (entered.length) { g.save(); g.textAlign = 'center'; g.textBaseline = 'middle'; g.font = '700 22px sans-serif'; let ex = w / 2 - (entered.length - 1) * 16; for (const id of entered) { g.fillStyle = GC[id % GC.length]; g.fillText(GLY[id % GLY.length], ex, 98); ex += 32; } g.textBaseline = 'alphabetic'; g.restore(); }
          g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace"; g.fillText('TAP THE COMBO BACK', w / 2, h - 14); if (el >= deadline && !done) { done = true; cleanup(); setTimeout(() => res(ev), 200); return; } }
        if (t >= dur && !done) { done = true; cleanup(); setTimeout(() => res(ev), 200); return; } if (!done) raf = requestAnimationFrame(fr); }
      function tap(e) { if (done) return; const t = performance.now() - t0; if (t < flashPhase) return; const r = canvas.getBoundingClientRect(), px = (e.clientX - r.left) * (w / r.width), py = (e.clientY - r.top) * (h / r.height); if (py < h - 96) return; const pw = (w - 40) / icons; let id = Math.floor((px - 20) / pw); id = Math.max(0, Math.min(icons - 1, id)); ev.push({ type: 'press', id, t: Math.round(t) }); flash = { id, t }; entered.push(id); burst(20 + id * pw + pw / 2, h - 66, GC[id % GC.length]); try { sfx.click(); } catch (e2) {} if (ev.length >= n) { done = true; cleanup(); setTimeout(() => res(ev), 220); } }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', tap); }
      canvas.addEventListener('pointerdown', tap); fr(); }); }

  // 10) OVERRIDE GRID — flip switches to match the target pattern in few moves under time.
  function pOverrideGrid(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const size = st.data.size || 5, start = (st.data.start || []).slice(), target = st.data.target || [], budget = st.data.moveBudget || size, deadline = st.data.deadline || 4000;
    return new Promise(res => { let raf, t0 = performance.now(), done = false; const state = start.slice(); let used = 0; const gap = Math.min((w - 40) / size, 70), x0 = (w - gap * (size - 1)) / 2, sy = h / 2 + 30, ty = h / 2 - 46;
      function fr() { const t = performance.now() - t0, rem = clamp(1 - t / deadline, 0, 1); bg(g, w, h); banner(g, w, 'OVERRIDE GRID');
        for (let i = 0; i < size; i++) { const X = x0 + i * gap; g.save(); g.strokeStyle = 'rgba(255,255,255,.06)'; g.lineWidth = 2; g.setLineDash([4, 5]); g.beginPath(); g.moveTo(X, ty + 18); g.lineTo(X, sy - 20); g.stroke(); g.setLineDash([]); g.restore(); }
        g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "11px 'Space Mono',monospace"; g.fillText('TARGET', w / 2, ty - 34);
        for (let i = 0; i < size; i++) { const X = x0 + i * gap; g.save(); if (target[i]) { g.fillStyle = RXAMB; g.shadowColor = RXAMB; g.shadowBlur = 12; g.beginPath(); g.arc(X, ty, 15, 0, TAU); g.fill(); } else { g.strokeStyle = 'rgba(120,132,124,.75)'; g.lineWidth = 2; g.beginPath(); g.arc(X, ty, 15, 0, TAU); g.stroke(); } g.restore(); }
        for (let i = 0; i < size; i++) { const X = x0 + i * gap; const match = state[i] === target[i]; g.save(); g.fillStyle = state[i] ? (match ? RXHOT : RXAMB) : 'rgba(80,92,84,.6)'; if (state[i]) { g.shadowColor = g.fillStyle; g.shadowBlur = 12; } roundRect(g, X - 18, sy - 18, 36, 36, 8); g.fill(); g.restore();
          if (!match) { const p = 0.5 + 0.5 * Math.sin(t / 200); g.save(); g.globalAlpha = 0.45 + 0.55 * p; g.strokeStyle = RXAMB; g.lineWidth = 2.5; roundRect(g, X - 21, sy - 21, 42, 42, 9); g.stroke(); g.restore(); } else { g.save(); g.fillStyle = '#04121a'; g.textAlign = 'center'; g.textBaseline = 'middle'; g.font = "800 18px 'Chakra Petch',sans-serif"; g.fillText('✓', X, sy); g.textBaseline = 'alphabetic'; g.restore(); } }
        const left = Math.max(0, budget - used); g.fillStyle = used > budget ? RXRED : RXHOT; g.textAlign = 'center'; g.font = "700 13px 'Space Mono',monospace"; g.fillText('MOVES LEFT ' + left, w / 2, 56); g.fillStyle = 'rgba(255,255,255,.08)'; g.fillRect(20, 66, w - 40, 4); g.fillStyle = rem < 0.3 ? RXRED : RXHOT; g.fillRect(20, 66, (w - 40) * rem, 4);
        g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace"; g.fillText('TAP THE BOTTOM SWITCHES TO MATCH THE TOP', w / 2, h - 14);
        let allMatch = true; for (let i = 0; i < size; i++) if (state[i] !== target[i]) allMatch = false;
        if ((allMatch || t >= deadline) && !done) { done = true; cleanup(); setTimeout(() => res(ev), 240); return; } if (!done) raf = requestAnimationFrame(fr); }
      function tap(e) { if (done) return; const t = Math.round(performance.now() - t0); const r = canvas.getBoundingClientRect(), px = (e.clientX - r.left) * (w / r.width), py = (e.clientY - r.top) * (h / r.height); if (Math.abs(py - sy) > 26) return; let i = Math.round((px - x0) / gap); if (i < 0 || i >= size) return; state[i] = 1 - state[i]; used++; ev.push({ type: 'press', id: i, t }); try { sfx.click(); } catch (e2) {} }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', tap); }
      canvas.addEventListener('pointerdown', tap); fr(); }); }

  // 11) POWER METER — hold to charge to the target value, release.
  function pPowerMeter(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const rate = st.data.rate || 0.7, target = st.data.target != null ? st.data.target : 0.6, dur = st.data.dur || 6000;
    const gx = w / 2 - 34, gw = 68, topY = 70, botY = h - 90, gh = botY - topY;
    return new Promise(res => { let raf, t0 = performance.now(), done = false, holding = false, holdStart = 0;
      function fr() { const t = performance.now() - t0; const hold = holding ? (performance.now() - holdStart) : 0; const v = clamp(rate * hold / 1000, 0, 1.15); bg(g, w, h); banner(g, w, 'POWER METER'); _rxTimeBar(g, w, t, dur);
        g.fillStyle = 'rgba(8,12,10,.85)'; roundRect(g, gx, topY, gw, gh, 8); g.fill();
        const ty = botY - clamp(target, 0, 1) * gh; g.save(); g.strokeStyle = RXHOT; g.shadowColor = RXHOT; g.shadowBlur = 8; g.lineWidth = 3; g.beginPath(); g.moveTo(gx - 8, ty); g.lineTo(gx + gw + 8, ty); g.stroke(); g.restore();
        const fy = botY - clamp(v, 0, 1) * gh; g.save(); g.fillStyle = RXAMB; g.shadowColor = RXAMB; g.shadowBlur = 12; g.fillRect(gx + 3, fy, gw - 6, botY - fy); g.restore();
        g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace"; g.fillText(holding ? 'RELEASE ON THE GREEN LINE' : 'HOLD TO CHARGE', w / 2, h - 14);
        if (t >= dur && !done) { done = true; cleanup(); setTimeout(() => res(ev), 220); return; } if (!done) raf = requestAnimationFrame(fr); }
      function down() { if (done || holding) return; holding = true; holdStart = performance.now(); ev.push({ type: 'down', t: Math.round(holdStart - t0) }); try { sfx.whir(); } catch (e) {} }
      function up() { if (done || !holding) return; holding = false; done = true; ev.push({ type: 'up', t: Math.round(performance.now() - t0) }); try { sfx.lock(); } catch (e) {} burst(w / 2, h / 2, RXAMB); cleanup(); setTimeout(() => res(ev), 240); }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', down); canvas.removeEventListener('pointerup', up); canvas.removeEventListener('pointerleave', up); }
      canvas.addEventListener('pointerdown', down); canvas.addEventListener('pointerup', up); canvas.addEventListener('pointerleave', up); fr(); }); }

  // 12) RECOIL CONTROL — value decays; tap to push it up; keep it in band.
  function pRecoilCtl(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const decay = st.data.decay || 0.4, kick = st.data.kick || 0.17, bandLo = st.data.bandLo != null ? st.data.bandLo : 0.42, bandHi = st.data.bandHi != null ? st.data.bandHi : 0.58, dur = st.data.dur || 6000;
    const topY = 70, botY = h - 90, gh = botY - topY, gx = w / 2 - 40, gw = 80;
    return new Promise(res => { let raf, t0 = performance.now(), done = false, v = 0.5, lastReal = performance.now();
      function fr() { const now = performance.now(), t = now - t0; const dt = (now - lastReal) / 1000; lastReal = now; v = clamp(v - decay * dt, 0, 1); bg(g, w, h); banner(g, w, 'RECOIL CONTROL'); _rxTimeBar(g, w, t, dur);
        g.fillStyle = 'rgba(8,12,10,.85)'; roundRect(g, gx, topY, gw, gh, 8); g.fill();
        const yLo = botY - bandHi * gh, hBand = (bandHi - bandLo) * gh; g.save(); g.fillStyle = 'rgba(61,255,143,.22)'; g.fillRect(gx, yLo, gw, hBand); g.strokeStyle = RXHOT; g.lineWidth = 1.5; g.strokeRect(gx, yLo, gw, hBand); g.restore();
        const inb = v >= bandLo && v <= bandHi; const fy = botY - v * gh; g.save(); g.fillStyle = inb ? RXHOT : RXAMB; g.shadowColor = g.fillStyle; g.shadowBlur = 12; g.fillRect(gx + 3, fy - 3, gw - 6, 6); g.restore();
        g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace"; g.fillText('TAP TO HOLD IT IN THE BAND', w / 2, h - 14);
        if (t >= dur && !done) { done = true; cleanup(); setTimeout(() => res(ev), 220); return; } if (!done) raf = requestAnimationFrame(fr); }
      function tap() { if (done) return; const t = Math.round(performance.now() - t0); ev.push({ type: 'tap', t }); v = clamp(v + kick, 0, 1); try { sfx.click(); } catch (e) {} }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', tap); }
      canvas.addEventListener('pointerdown', tap); fr(); }); }

  // 13) ANGLE LAUNCH — set an angle, then a power (two commits); land in the zone.
  function pAngleLaunch(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const zoneX = st.data.zoneX != null ? st.data.zoneX : 0.6, zoneW = st.data.zoneW || 0.15, dur = st.data.dur || 9000;
    return new Promise(res => { let raf, t0 = performance.now(), done = false, phase = 0, sweep = 0, ang = 0.5, pow = 0.5, dir = 1, landed = false, landT = 0;
      const floorY = h - 60, ox = 30;
      function fr() { const t = performance.now() - t0; bg(g, w, h); banner(g, w, 'ANGLE LAUNCH'); _rxTimeBar(g, w, t, dur);
        if (phase < 2) { sweep += 0.022 * dir; if (sweep > 1) { sweep = 1; dir = -1; } else if (sweep < 0) { sweep = 0; dir = 1; } if (phase === 0) ang = sweep; else pow = sweep; }
        const zx0 = ox + zoneX * (w - 60) - zoneW * (w - 60) / 2, zw = zoneW * (w - 60); g.save(); g.fillStyle = 'rgba(61,255,143,.25)'; g.fillRect(zx0, floorY - 6, zw, 12); g.strokeStyle = RXHOT; g.lineWidth = 1.5; g.strokeRect(zx0, floorY - 6, zw, 12); g.restore();
        const theta = 0.15 + ang * 1.2; g.save(); g.strokeStyle = RXAMB; g.lineWidth = 3; g.beginPath(); g.moveTo(ox, floorY); g.lineTo(ox + Math.cos(theta) * 70, floorY - Math.sin(theta) * 70); g.stroke(); g.restore();
        g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace";
        if (phase === 0) g.fillText('TAP TO SET THE ANGLE', w / 2, 60); else if (phase === 1) { g.fillText('TAP TO SET THE POWER', w / 2, 60); g.fillStyle = RXAMB; g.fillRect(ox, 66, (w - 60) * pow, 5); }
        if (phase === 2) { const range = clamp(pow * pow * Math.sin(2 * theta), 0, 1); const lx = ox + range * (w - 60); const powEv = ev.find(e => e.k === 'power'); const commitT = powEv ? powEv.t : t; const prog = clamp((t - commitT) / 900, 0, 1); const peak = (0.18 + 0.55 * Math.sin(theta) * pow) * (floorY - 80);
          g.save(); g.strokeStyle = 'rgba(255,210,74,.22)'; g.setLineDash([4, 5]); g.lineWidth = 2; g.beginPath(); for (let s = 0; s <= 30; s++) { const p = s / 30, X = ox + (lx - ox) * p, Y = floorY - peak * 4 * p * (1 - p); s ? g.lineTo(X, Y) : g.moveTo(X, Y); } g.stroke(); g.setLineDash([]); g.restore();
          const bx = ox + (lx - ox) * prog, by = floorY - peak * 4 * prog * (1 - prog); g.save(); g.fillStyle = RXAMB; g.shadowColor = RXAMB; g.shadowBlur = 16; g.beginPath(); g.arc(bx, by, 8, 0, TAU); g.fill(); g.restore();
          if (prog >= 1) { const inZone = lx >= zx0 && lx <= zx0 + zw; if (!landed) { landed = true; landT = t; burst(lx, floorY, inZone ? RXHOT : RXRED); } g.save(); g.fillStyle = inZone ? RXHOT : RXRED; g.shadowColor = g.fillStyle; g.shadowBlur = 18; g.textAlign = 'center'; g.font = "800 30px 'Chakra Petch',sans-serif"; g.fillText(inZone ? 'IN THE ZONE' : 'MISS', w / 2, floorY - 64); g.restore(); } }
        g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace"; g.fillText('LAND THE SHOT IN THE ZONE', w / 2, h - 14);
        if (landed && t > landT + 750 && !done) { done = true; cleanup(); setTimeout(() => res(ev), 200); return; }
        if (t >= dur && !done) { done = true; cleanup(); setTimeout(() => res(ev), 200); return; } if (!done) raf = requestAnimationFrame(fr); }
      function tap() { if (done) return; const t = Math.round(performance.now() - t0); if (phase === 0) { ev.push({ type: 'commit', k: 'angle', v: +ang.toFixed(3), t }); phase = 1; sweep = 0; dir = 1; try { sfx.click(); } catch (e) {} } else if (phase === 1) { ev.push({ type: 'commit', k: 'power', v: +pow.toFixed(3), t }); phase = 2; try { sfx.lock(); } catch (e) {} } }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', tap); }
      canvas.addEventListener('pointerdown', tap); fr(); }); }

  // 14) PRESSURE VALVE — pressure rises; tap to vent; keep the needle in a MOVING band.
  function pPressureValve(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const rise = st.data.rise || 0.4, vent = st.data.vent || 0.18, bandW = st.data.bandW || 0.18, bandOmega = st.data.bandOmega || 0.0012, bandAmp = st.data.bandAmp || 0.26, dur = st.data.dur || 6500;
    const topY = 70, botY = h - 90, gh = botY - topY, gx = w / 2 - 40, gw = 80;
    return new Promise(res => { let raf, t0 = performance.now(), done = false, v = 0.5, lastReal = performance.now();
      function fr() { const now = performance.now(), t = now - t0; const dt = (now - lastReal) / 1000; lastReal = now; v = clamp(v + rise * dt, 0, 1); const center = 0.5 + bandAmp * Math.sin(bandOmega * t); bg(g, w, h); banner(g, w, 'PRESSURE VALVE'); _rxTimeBar(g, w, t, dur);
        g.fillStyle = 'rgba(8,12,10,.85)'; roundRect(g, gx, topY, gw, gh, 8); g.fill();
        const yTop = botY - clamp(center + bandW / 2, 0, 1) * gh, hB = bandW * gh; g.save(); g.fillStyle = 'rgba(61,255,143,.22)'; g.fillRect(gx, yTop, gw, hB); g.strokeStyle = RXHOT; g.lineWidth = 1.5; g.strokeRect(gx, yTop, gw, hB); g.restore();
        const inb = Math.abs(v - center) <= bandW / 2; const fy = botY - v * gh; g.save(); g.fillStyle = inb ? RXHOT : RXRED; g.shadowColor = g.fillStyle; g.shadowBlur = 12; g.fillRect(gx + 3, fy - 3, gw - 6, 6); g.restore();
        g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace"; g.fillText('TAP TO VENT, STAY IN THE BAND', w / 2, h - 14);
        if (t >= dur && !done) { done = true; cleanup(); setTimeout(() => res(ev), 220); return; } if (!done) raf = requestAnimationFrame(fr); }
      function tap() { if (done) return; const t = Math.round(performance.now() - t0); ev.push({ type: 'tap', t }); v = clamp(v - vent, 0, 1); try { sfx.click(); } catch (e) {} }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', tap); }
      canvas.addEventListener('pointerdown', tap); fr(); }); }

  // 15) RICOCHET — one drag-to-aim, release; bank the shot off the wall into the target.
  function pRicochet(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const originX = st.data.originX != null ? st.data.originX : 0.2, wallY = st.data.wallY != null ? st.data.wallY : 0.5, targetX = st.data.targetX != null ? st.data.targetX : 0.6, dur = st.data.dur || 9000;
    const PX = x => 20 + x * (w - 40), PY = y => 40 + y * (h - 80); const ox = PX(originX), oy = PY(0.95), wy = PY(wallY), tx = PX(targetX), fy = PY(0.95);
    return new Promise(res => { let raf, t0 = performance.now(), done = false, aiming = false, aim = { x: originX, y: 0.6 }, committed = false, shotT = 0, landed = false, landT = 0, hit = false;
      function fr() { const t = performance.now() - t0; bg(g, w, h); banner(g, w, 'RICOCHET'); _rxTimeBar(g, w, t, dur);
        g.strokeStyle = RXCOLD; g.lineWidth = 4; g.beginPath(); g.moveTo(20, wy); g.lineTo(w - 20, wy); g.stroke();   // the wall
        { const pl = 0.55 + 0.45 * Math.sin(t / 220); g.save(); g.translate(tx, fy); g.strokeStyle = RXHOT; g.shadowColor = RXHOT; g.shadowBlur = 14; g.globalAlpha = 0.5 + 0.5 * pl; g.lineWidth = 3; g.beginPath(); g.arc(0, 0, 17, 0, TAU); g.stroke(); g.globalAlpha = 1; g.lineWidth = 2; g.beginPath(); g.arc(0, 0, 9, 0, TAU); g.stroke(); g.fillStyle = RXHOT; g.beginPath(); g.arc(0, 0, 3.5, 0, TAU); g.fill(); g.restore(); g.save(); g.fillStyle = RXHOT; g.textAlign = 'center'; g.font = "700 10px 'Space Mono',monospace"; g.fillText('▼ TARGET', tx, fy - 26); g.restore(); }   // bullseye target on floor
        g.save(); g.fillStyle = RXAMB; g.shadowColor = RXAMB; g.shadowBlur = 8; g.beginPath(); g.arc(ox, oy, 8, 0, TAU); g.fill(); g.restore();   // amber ball at origin
        if (aiming) { g.strokeStyle = 'rgba(255,210,74,.7)'; g.setLineDash([4, 5]); g.lineWidth = 2; g.beginPath(); g.moveTo(ox, oy); g.lineTo(PX(aim.x), PY(aim.y)); g.stroke(); g.setLineDash([]); }
        if (committed) { const dx = aim.x - originX, dy = aim.y - 0.95; if (dy < -0.02) { const tWall = (wallY - 0.95) / dy; const wallHitX = clamp(originX + dx * tWall, 0, 1); const tFloor = (0.95 - wallY) / (-dy); const landX = clamp(wallHitX + dx * tFloor, 0, 1); const prog = clamp((t - shotT) / 700, 0, 1); let bx, by; if (prog < 0.5) { const p2 = prog / 0.5; bx = originX + (wallHitX - originX) * p2; by = 0.95 + (wallY - 0.95) * p2; } else { const p2 = (prog - 0.5) / 0.5; bx = wallHitX + (landX - wallHitX) * p2; by = wallY + (0.95 - wallY) * p2; } g.save(); g.fillStyle = RXAMB; g.shadowColor = RXAMB; g.shadowBlur = 14; g.beginPath(); g.arc(PX(bx), PY(by), 7, 0, TAU); g.fill(); g.restore(); if (prog >= 1 && !landed) { landed = true; landT = t; hit = Math.abs(landX - targetX) <= 0.06; burst(PX(landX), fy, hit ? RXHOT : RXRED); } } else if (!done) { done = true; cleanup(); setTimeout(() => res(ev), 200); return; } }
        if (landed) { g.save(); g.fillStyle = hit ? RXHOT : RXRED; g.shadowColor = g.fillStyle; g.shadowBlur = 18; g.textAlign = 'center'; g.font = "800 26px 'Chakra Petch',sans-serif"; g.fillText(hit ? 'HIT' : 'MISS', w / 2, 92); g.restore(); if (t > landT + 650 && !done) { done = true; cleanup(); setTimeout(() => res(ev), 180); return; } }
        g.fillStyle = '#8a9a8f'; g.textAlign = 'center'; g.font = "12px 'Space Mono',monospace"; g.fillText(committed ? '' : 'DRAG TO AIM, RELEASE TO BANK THE SHOT', w / 2, h - 14);
        if (t >= dur && !done) { done = true; cleanup(); setTimeout(() => res(ev), 200); return; } if (!done) raf = requestAnimationFrame(fr); }
      function pos(e) { const r = canvas.getBoundingClientRect(); return { x: clamp(((e.clientX - r.left) * (w / r.width) - 20) / (w - 40), 0, 1), y: clamp(((e.clientY - r.top) * (h / r.height) - 40) / (h - 80), 0, 1) }; }
      function down(e) { if (done || committed) return; aiming = true; aim = pos(e); }
      function move(e) { if (!aiming || done) return; aim = pos(e); }
      function up() { if (!aiming || done) return; aiming = false; committed = true; shotT = performance.now() - t0; ev.push({ type: 'commit', x: +aim.x.toFixed(3), y: +aim.y.toFixed(3), t: Math.round(shotT) }); try { sfx.lock(); } catch (e) {} }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', down); canvas.removeEventListener('pointermove', move); canvas.removeEventListener('pointerup', up); canvas.removeEventListener('pointerleave', up); }
      canvas.addEventListener('pointerdown', down); canvas.addEventListener('pointermove', move); canvas.addEventListener('pointerup', up); canvas.addEventListener('pointerleave', up); fr(); }); }

  // SKILL V4 registrations (Jake 2026-09-12)
  P.gonogo = pGoNoGo; P.oddsignal = pOddSignal; P.trapdoor = pTrapdoor; P.colourcall = pColourCall; P.twitchrelease = pTwitchRelease;
  P.safeproc = pSafeProc; P.lockorder = pLockOrder; P.counterrot = pCounterRot; P.repeatcombo = pRepeatCombo; P.overridegrid = pOverrideGrid;
  P.powermeter = pPowerMeter; P.recoilctl = pRecoilCtl; P.anglelaunch = pAngleLaunch; P.pressurevalve = pPressureValve; P.ricochet = pRicochet;

  window.RTV_SKILL_REMOTE = { run, playInto, start, grade, countdown, howto, directions, games: Object.keys(P) };
})();
