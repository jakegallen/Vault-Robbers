      const near = t => { let d = 1e9; for (const b of beats) d = Math.min(d, Math.abs(b - t)); return d; };
      function fr() { const t = performance.now() - t0; bg(g, w, h); banner(g, w, label); _ryBar(g, w, t, dur); draw(g, w, h, t, near, fl);
