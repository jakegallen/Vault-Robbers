  function pEchoReverse(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const gaps = st.data.gaps || [], showDur = st.data.showDur || 2500, dur = st.data.dur || 8000, cx = w / 2, cy = h / 2 + 6; const marks = []; { let a = 700; marks.push(a); for (const gp of gaps) { a += gp; marks.push(a); } }
    // A LEFT->RIGHT timeline of pips laid out at each flash time makes REVERSE concrete: watch it fill L->R, then tap it back filling R->L.
