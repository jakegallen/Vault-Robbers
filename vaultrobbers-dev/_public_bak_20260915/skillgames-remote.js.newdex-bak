  function pGapThreader(canvas, st) { const walls = st.data.walls || [], fall = st.data.fall || 900, dur = st.data.dur || 6000;
    return _dxDrag(canvas, st, 'GAP THREADER', 'SLIDE INTO EACH GAP BEFORE THE WALL LANDS', function (g, w, h, t, cur, dragging) { const dotY = h - 74, dx = cur.x * w;
