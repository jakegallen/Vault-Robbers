  function beep(f) { try { var vv = _shVol(); if (vv <= 0) return; _ensureAC(); const o = _ac.createOscillator(), gg = _ac.createGain(); o.frequency.value = f || 700; gg.gain.value = 0.0001; gg.gain.linearRampToValueAtTime(0.16 * vv, _ac.currentTime + 0.01); gg.gain.exponentialRampToValueAtTime(0.0001, _ac.currentTime + 0.14); o.connect(gg); gg.connect(_ac.destination); o.start(); o.stop(_ac.currentTime + 0.16); } catch (e) {} }
