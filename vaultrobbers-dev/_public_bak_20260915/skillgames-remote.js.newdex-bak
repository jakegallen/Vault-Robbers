      g.strokeStyle = 'rgba(0,0,0,.55)'; g.beginPath(); g.arc(cx, cy, r, Math.PI * 0.05, Math.PI * 0.95); g.stroke();
      if (tint) { g.globalAlpha = 0.5; g.lineWidth = thick * 0.5; g.strokeStyle = tint; g.beginPath(); g.arc(cx, cy, r, 0, TAU); g.stroke(); }
      g.restore();
    },
