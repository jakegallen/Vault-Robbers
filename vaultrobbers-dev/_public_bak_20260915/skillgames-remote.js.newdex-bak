      g.fillStyle = '#cbbf9e'; g.font = "600 11px 'Space Mono',monospace"; g.fillText(dp < (shape === 'set' ? 0.45 : 0.5) ? 'WATCH' : (shape === 'set' ? 'PICK THE SET' : 'REPEAT'), bcx, by1 + 4);
