  function pComboChain(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const beats = st.data.beats || [], dur = st.data.dur || 6000, cx = w / 2, cy = h / 2 + 6, tol = st.data.tol || 200; let streak = 0, li = 0;
