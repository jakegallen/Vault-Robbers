        if (H) { const inDown = Math.abs(t - H.down) < tol, inUp = Math.abs(t - H.up) < tol, active = t >= H.down && t <= H.up; g.save(); g.strokeStyle = active ? '#3dff8f' : (inDown || inUp ? '#ffd24a' : '#7fd0ff'); g.shadowColor = g.strokeStyle; g.shadowBlur = 14; g.lineWidth = 6; const prog = active ? clamp((t - H.down) / (H.up - H.down), 0, 1) : 0; g.beginPath(); g.arc(cx, cy, R * 0.7, -Math.PI / 2, -Math.PI / 2 + (active ? prog : 1) * TAU); g.stroke(); g.restore(); }
