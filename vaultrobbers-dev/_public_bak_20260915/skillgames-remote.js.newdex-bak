      g.save(); const face = g.createRadialGradient(cx - R * .3, cy - R * .3, R * .1, cx, cy, R); face.addColorStop(0, '#20221f'); face.addColorStop(1, '#0c0d0b'); g.fillStyle = face; g.beginPath(); g.arc(cx, cy, R, 0, TAU); g.fill(); g.restore();
