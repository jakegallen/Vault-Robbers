  function pLaserCorridor(canvas, st) { const lasers = st.data.lasers || [], dur = st.data.dur || 6500;
    return _dxDrag(canvas, st, 'LASER CORRIDOR', 'CROSS EACH LASER ONLY WHILE IT IS DARK', function (g, w, h, t, cur, dragging) { const y0 = 50, yh = h - 96;
