  function pSustainHold(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const holds = st.data.holds || [], dur = st.data.dur || 6000, tol = st.data.tol || 230, cx = w / 2, cy = h / 2 + 6, R = Math.min(w, h) * 0.26;
