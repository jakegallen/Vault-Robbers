    g.save(); g.shadowColor = '#000'; g.shadowBlur = 6; g.fillStyle = '#ffe08a'; g.beginPath(); g.moveTo(cx + R + 2, cy); g.lineTo(cx + R + 19, cy - 8); g.lineTo(cx + R + 19, cy + 8); g.closePath(); g.fill(); g.restore();   // pointer
