    g.save(); g.globalAlpha = 0.5; const rl = g.createLinearGradient(0, 30, 0, 96); rl.addColorStop(0, 'rgba(255,200,90,.18)'); rl.addColorStop(1, 'rgba(255,200,90,0)'); g.fillStyle = rl; g.fillRect(0, 30, w, 66); g.restore();
