      function tap() { if (done) return; const t = Math.round(performance.now() - t0); ev.push({ type: 'tap', t }); const ok = near(t) <= tol; fl.push({ t: performance.now() - t0, ok }); try { sfx.lock(); } catch (e) {} }
      function cleanup() { cancelAnimationFrame(raf); canvas.removeEventListener('pointerdown', tap); }
      canvas.addEventListener('pointerdown', tap); fr(); }); }

  function pEchoTap(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const gaps = st.data.gaps || [], showDur = st.data.showDur || 2500, dur = st.data.dur || 8000, cx = w / 2, cy = h / 2 + 6; const marks = []; { let a = 700; marks.push(a); for (const gp of gaps) { a += gp; marks.push(a); } }
    return new Promise(res => { let raf, t0 = performance.now(), done = false, phase = 1; const fl = [];
      function fr() { const t = performance.now() - t0; bg(g, w, h); banner(g, w, 'ECHO TAP');
