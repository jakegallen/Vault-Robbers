  async function pRhythm(canvas, st) {
    const { g, w, h } = fit(canvas); const ev = []; bg(g, w, h); banner(g, w, 'LISTEN');
    try { const a = new Audio(st.audioURL || ('api/skill/audio?sid=' + encodeURIComponent(st.sid))); await a.play().catch(() => {}); } catch (e) {}
