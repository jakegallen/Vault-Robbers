  function pTiltBalance(canvas, st) { const { g, w, h } = fit(canvas); const ev = []; const grav = st.data.grav || 0.0006, dur = st.data.dur || 7000, tol = st.data.tol || 0.18, drift = st.data.drift || 0.0008, driftPhase = st.data.driftPhase || 0, driftFreq = st.data.driftFreq || 0.002, setAmp = st.data.setAmp || 0.16, setFx = st.data.setFx || 0.0005, setPhase = st.data.setPhase || 0; let bx = 0.5, bv = 0, tiltX = 0.5, last = 0, dragging = false, everHeld = false;
