          for (let i = fl.length - 1; i >= 0; i--) { const a = 1 - (t - fl[i].t) / 300; if (a <= 0) { fl.splice(i, 1); continue; } g.save(); g.globalAlpha = a * 0.5; g.fillStyle = '#3dff8f'; g.beginPath(); g.arc(fl[i].x, pipY, 14 * (1 + (1 - a)), 0, TAU); g.fill(); g.restore(); } }
