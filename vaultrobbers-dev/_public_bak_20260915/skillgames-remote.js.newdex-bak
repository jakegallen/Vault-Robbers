        else { phase = 2; _ryBar(g, w, t - showDur, dur - showDur); g.fillStyle = '#3dff8f'; g.textAlign = 'center'; g.font = "13px 'Space Mono',monospace"; g.fillText('TAP IT BACK IN REVERSE', cx, 40);
