      canvas.addEventListener('pointerdown', down); canvas.addEventListener('pointerup', up); canvas.addEventListener('pointerleave', up); fr(); }); }

  function pOffBeat(canvas, st) { const ticks = st.data.ticks || [], offs = st.data.offs || [], cx = c => c, cy = 0;
    return _ryTap(canvas, st, 'OFF BEAT', 'TAP BETWEEN THE TICKS, NOT ON THEM', offs, (st.data.tol || 200), function (g, w, h, t, near, fl) { const bx = w / 2, by = h / 2 + 6, R = Math.min(w, h) * 0.26;
