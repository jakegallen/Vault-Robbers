    return new Promise(res => { let raf, t0 = performance.now(), done = false, phase = 1, tapped = 0; const fl = [];
      function connectorLine() { g.save(); g.strokeStyle = 'rgba(125,208,255,.18)'; g.lineWidth = 2; g.beginPath(); g.moveTo(pipAt(0), pipY); g.lineTo(pipAt(N - 1), pipY); g.stroke(); g.restore(); }
