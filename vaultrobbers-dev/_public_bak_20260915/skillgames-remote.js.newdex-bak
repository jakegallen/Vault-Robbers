  function pCoilUnwind(canvas, st) { const turns = st.data.turns || 2, dir = st.data.dir || 1, dur = st.data.dur || 7000, wobA = st.data.wobA || 0, wobF = st.data.wobF || 0, wobP = st.data.wobP || 0;
