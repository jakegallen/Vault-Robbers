    for (let i = arr.length - 1; i > 0; i--) { const j = Math.floor(_u(b, i) * (i + 1)) % (i + 1); const t = arr[i]; arr[i] = arr[j]; arr[j] = t; }
    d3 = [arr[0], arr[1], arr[2]];
  } else {   // deep gate: only 2 rare-gating kinds — assign each door independently (repeats OK) so a deep room is always a hard wall (dexterity) or a fate gate (luck), never a soft lane
    d3 = [0, 1, 2].map(i => kinds[Math.floor(_u(b, i + 7) * kinds.length) % kinds.length]);
