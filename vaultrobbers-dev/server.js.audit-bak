        const winR = (cvw && cvw.potRvlt != null) ? cvw.potRvlt : num(st.pot_rvlt);   // and robs the entire RVLT pot (stage-10 share = 100%)
        await bumpState({ jackpot_eth: -(num(st.jackpot_eth) + acc), pot_rvlt: -num(st.pot_rvlt), robs: 1 });   // drain the DB mirror to ~0 (vault emptied on-chain) so it can't keep drifting; plays already counted at entry
        await dbExec("INSERT INTO rtv_runs (player,stake,depth,outcome,won_rvlt,robbed_eth,net,server_seed,server_hash,client_seed) VALUES (?,?,?,?,?,?,?,?,?,?)", [row.player, FEE, LEVELS, 'rob', winR, take, OC.chainId, row.server_seed, row.server_hash, row.client_seed]);
        await dbExec("UPDATE rtv_seeds SET status='robbed', depth=?, cur_started=? WHERE run_id=? AND status='open'", [LEVELS, Date.now(), runId]);   // A5: stamp cur_started at the moment of the crack — settle-sig uses it as the start of the mandatory core-hold window (no more crack challenges run on a robbed row, so reusing the column is safe)
        payout.wonRvlt = winR;
        try { breakerNote('core', winR); } catch (e) {}   // circuit breaker: record a core drain (the real bleed vector)
        try { if (row.player) computeWalletRep(row.player).catch(() => {}); } catch (e) {}   // ADDITION 1: refresh wallet reputation on a core win (NON-BLOCKING, fire-and-forget)
      }
      // NOTE: roll / effOdds / baseChance intentionally NOT returned — the client must never learn the actual odds (Jake).
      res.json({ success: true, level, door, gameKey: act.gameKey, kind: act.kind, score, human, flagged, potShare: potShareFor(level), robbed, doors: robbed ? undefined : doorsLayout(row.server_seed, level + 1), serverSeed: robbed ? row.server_seed : undefined, ...payout });
    } else {
      // Bust: the fee was already consumed at entry (burned + chips into pot), and the chips stay in the pot for others. No
      // further burn or pot change — just end the run.
      await dbExec("INSERT INTO rtv_runs (player,stake,depth,outcome,burned_rvlt,net,server_seed,server_hash,client_seed) VALUES (?,?,?,?,?,?,?,?,?)", [row.player, FEE, level - 1, 'fail', FEE * BURN_SHARE, OC.chainId, row.server_seed, row.server_hash, row.client_seed]);
      await dbExec("UPDATE rtv_seeds SET status='busted', nonce=? WHERE run_id=? AND status='open'", [nonce, runId]);
      // Loss reveal (Nerve only): the run is over and the seed is already returned, so showing where the hidden line/step was is safe
      // and teaches the push-your-luck lesson ("you pushed one step too far"). Only when the MINI was busted, not a roll loss.
      let reveal = null;
      if (act.v4 && act.kind === 'nerve' && act.built && act.built.secret) {   // v4 nerve loss (busted OR missed the tight window): show the line + your stop VISUALLY
        const bk = events.find(e => e && e.type === 'bank');
        reveal = { mini: 'gaugeV4', line: act.built.secret.line, banked: bk ? Math.max(0, Math.min(1.3, act.built.secret.speed * ((bk.t || 0) / 1000))) : null };
      } else if (act.v4 && act.kind === 'memory') {   // memory loss: honest, never an "ignored win" — distinguish a short recall from an aced-recall-but-roll-held
        reveal = (score >= _v4.s.MEMORY_BAR[level - 1])
          ? { mini: 'memory', msg: 'Perfect recall. But this deep the inner vault only grants a chance, and the roll held it shut.' }
          : { mini: 'memory', msg: 'Your recall came up short of the mark. Hold the pattern tighter next time.' };
      } else if (act.v4 && act.kind === 'perception') {   // V2 perception loss: honest — aced the read but the deep rarity roll held, vs a short read
        reveal = (score >= _v4.s.PERCEPTION_BAR[level - 1])
          ? { mini: 'perception', msg: 'Sharp read. But this deep the inner vault only grants a chance, and the roll held it shut.' }
          : { mini: 'perception', msg: 'Your read came up short. Trust the glance, not the trick.' };
      } else if (act.v4 && act.kind === 'rhythm') {   // V2 rhythm loss: honest — clean beat but the deep roll held, vs off the beat
        const _dtl = (act.door && _v4.s.RHYTHM_BAR_T[act.door]) ? act.door : 'center';
        reveal = (score >= _v4.s.RHYTHM_BAR_T[_dtl][level - 1])
          ? { mini: 'rhythm', msg: 'Clean on the beat. But this deep the inner vault only grants a chance, and the roll held it shut.' }
          : { mini: 'rhythm', msg: 'You drifted off the beat. Lock onto the pulse and hit it clean.' };
      } else if (act.v4 && act.kind === 'dexterity') {   // V2 dexterity loss: honest — steady line but the deep roll held, vs shaky line
        const _dtl = (act.door && _v4.s.DEXTERITY_BAR_T[act.door]) ? act.door : 'center';
        reveal = (score >= _v4.s.DEXTERITY_BAR_T[_dtl][level - 1])
          ? { mini: 'dexterity', msg: 'Steady line. But this deep the inner vault only grants a chance, and the roll held it shut.' }
          : { mini: 'dexterity', msg: 'The line got away from you. Steadier hands next time.' };
      } else if (failedMini) {
        const CLIMB = ['ladder', 'minefield', 'cascadelocks', 'ziplinebail', 'defuse', 'vaultstack', 'heisttimer', 'dominoes'];
        const GAUGE = ['holddrill', 'crank', 'pressure', 'overload', 'dive', 'thermite', 'staticcharge', 'crackdrill', 'nitro', 'guardsweep'];
        if (CLIMB.includes(act.gameKey) && act.ch.fail != null) { const c = events.filter(e => e && e.type === 'climb').length; reveal = { mini: 'climb', trap: act.ch.fail, reached: c, total: act.ch.rungs }; }
        else if (GAUGE.includes(act.gameKey) && act.ch.danger != null) { const st = events.find(e => e && e.type === 'stop'); const f = st ? Math.max(0, Math.min(1, st.t / act.ch.maxMs)) : 1; reveal = { mini: 'gauge', line: Math.round(act.ch.danger * 100), held: Math.round(f * 100) }; }
        else {   // SKILL loss reveal: an honest one-line "here's the miss" so a failed skill door also teaches (run is over → safe to reveal)
          const gk = act.gameKey, ch = act.ch, taps = events.filter(e => e && Number.isFinite(e.t)); let msg = null;
          if (gk === 'dial') { const lk = taps.find(e => e.type === 'lock'); if (!lk) msg = 'You never locked the dial.'; else { const a = (ch.start + ch.speed * (lk.t / 1000)) % (Math.PI * 2); const dd = Math.abs(((a - ch.target + Math.PI * 3) % (Math.PI * 2)) - Math.PI); msg = 'You locked ' + Math.round(dd * 180 / Math.PI) + '° off the mark.'; } }
          else if (gk === 'reflex' || gk === 'quickdraw' || gk === 'silentalarm') { const tp = taps.find(e => e.type === 'tap'); msg = !tp ? 'You never moved.' : (tp.t < ch.greenAt ? 'You moved before the signal.' : 'Too slow after the signal.'); }
          else if (gk === 'wirecut') { const c = taps.find(e => e.type === 'cut'); if (!c) msg = 'You never made the cut.'; else { const f = c.t / ch.travelMs; msg = f > ch.bandHi ? 'Too late — the spark reached the detonator.' : (f < ch.bandLo ? 'You cut too early, before the safe window.' : 'Just off the centre of the safe window.'); } }
          else if (gk === 'sequence') { const picks = taps.filter(e => e.type === 'pad'); let c = 0; for (let k = 0; k < ch.seq.length; k++) { if (picks[k] && picks[k].idx === ch.seq[k]) c++; else break; } msg = 'You matched ' + c + ' of ' + ch.seq.length + '.'; }
          else if (gk === 'lasers' || gk === 'lockpins' || gk === 'sonicrack' || gk === 'dialcombo' || gk === 'hotwire') { const h = taps.filter(e => e.type === 'tap').length; msg = 'You cleared ' + Math.min(h, ch.rounds) + ' of ' + ch.rounds + ' rounds.'; }
          else if (gk === 'targets' || gk === 'catch' || gk === 'pressureplates') { const n = taps.filter(e => e.type === 'tap').length; msg = 'You tagged ' + n + ' of ' + ch.n + '.'; }
          else if (gk === 'stopwatch' || gk === 'tumbler') { const s = taps.find(e => e.type === 'stop'); msg = !s ? 'You never stopped it.' : 'You stopped ' + Math.abs(Math.round(s.t - ch.target)) + 'ms off the mark.'; }
          else if (gk === 'mash' || gk === 'drilldepth') { const n = taps.filter(e => e.type === 'tap').length; msg = 'You reached ' + n + ' of ' + ch.need + '.'; }
          if (msg) reveal = { mini: 'skill', msg };
        }
      }
      // GAUNTLET honesty (Jake 2026-09-07): under ODDS_V2 the inner chambers (6-10) are NOT deterministic — a clean run (score>0)
      // only buys a CHANCE and the provably-fair roll decides. Players who mastered the deterministic approach (ch1-5) read a
      // roll-loss here as "the game ignored my win." Return an honest, in-world reveal so the deep loss is explained, not silent.
      // (Pure messaging — no odds change; the frozen/approved curve is untouched.)
      else if (SKILL_V3 && act.kind === 'skill' && score > 0) { reveal = { mini: 'skill', msg: 'So close. This deep the lock demands a near-flawless crack and you came up just short. Sharpen up and go again.' }; }
      else if (ODDS_V2 && act.kind === 'skill' && level >= 6 && score > 0) { reveal = { mini: 'gauntlet', msg: 'Clean run. But past the Bank Lobby the inner vault only grants a chance, and this time the roll held it shut.' }; }
      res.json({ success: false, level, door, gameKey: act.gameKey, kind: act.kind, score, human, flagged, serverSeed: row.server_seed, reveal });
    }
    });
  } catch (e) { res.status(500).json({ error: 'crack', detail: e.message }); }
});

// Walk away with the loot cleared so far. Body: { runId }. Pays stake × the run's accumulated multiple from the pot.
app.post('/api/cashout', async (req, res) => {
  try {
    if (ONCHAIN_ONLY && !FREE_PLAY) return res.status(403).json({ error: 'on-chain cash-out required — settle via the contract, not the demo path' });   // item #2: real cash-out is the contract settle
    const runId = String(req.body.runId || '');
    await withRunLock(runId, async () => {   // serialized vs /api/crack and vs another cashout — no double-pay from the pot
    const row = (await dbQuery("SELECT * FROM rtv_seeds WHERE run_id=?", [runId]).catch(() => []))[0];
    if (!row || row.status !== 'open') return res.status(400).json({ error: 'no open run' });
    const depth = num(row.depth);
    if (depth < CASHOUT_MIN) return res.status(400).json({ error: 'cash-out unlocks at chamber ' + CASHOUT_MIN });
    // Consume the run FIRST (atomic-under-lock): flip status before paying so a racing crack/cashout can't also pay.
    await dbExec("UPDATE rtv_seeds SET status='cashed' WHERE run_id=? AND status='open'", [runId]);
    const chk = (await dbQuery("SELECT status FROM rtv_seeds WHERE run_id=?", [runId]).catch(() => []))[0];
    if (!chk || chk.status !== 'cashed') return res.status(409).json({ error: 'already settled' });
    const st = await getState();
    const potWon = Math.max(0, payoutFor(depth, num(st.pot_rvlt)));   // Buy-Burn-Earn: min(pct*pot, cap), floored (legacy pure-% when flag off)
    const share = num(st.pot_rvlt) > 0 ? potWon / num(st.pot_rvlt) : 0;   // effective share for the response
    // V2 casino coupling (Jake 2026-09-07): fold this run's Vault Floor P&L into the cash-out. FLOORED at 0 so casino losses can
    // never make the run end owing more than staked; the pot only ever funds the ladder share, casino P&L is its own ledger.
    const cp = (await dbQuery("SELECT COALESCE(SUM(payout-wager),0) pnl FROM rtv_casino_bets WHERE run_id=? AND status IN ('won','lost','cashed')", [runId]).catch(() => [{ pnl: 0 }]))[0] || { pnl: 0 };
    const casinoPnl = Math.round(Number(cp.pnl) || 0);
    const won = Math.max(0, potWon + casinoPnl);
    await bumpState({ pot_rvlt: -potWon });                   // pot funds the ladder share only
    await dbExec("INSERT INTO rtv_runs (player,stake,depth,outcome,won_rvlt,net,server_seed,server_hash,client_seed) VALUES (?,?,?,?,?,?,?,?,?)", [row.player, FEE, depth, 'cashout', won, OC.chainId, row.server_seed, row.server_hash, row.client_seed]);
    res.json({ won, potWon, casinoPnl, depth, potShare: share, serverSeed: row.server_seed });
    });
  } catch (e) { res.status(500).json({ error: 'cashout', detail: e.message }); }
});

// Record an ON-CHAIN cash-out for the Activity log + stats. The client calls this AFTER its settle tx confirms. The demo
// /api/cashout is disabled on mainnet, and settle-sig only signs, so without this an on-chain cash-out never lands in rtv_runs.
// Server-authoritative + idempotent: only a paid, still-open run is recorded, and the atomic flip stops double-recording. (Jake 2026-09-05)
app.post('/api/onchain/settled', async (req, res) => {
  try {
    const runId = String((req.body && req.body.runId) || '');
    if (!runId) return res.json({ ok: false });
    await withRunLock(runId, async () => {
      const row = (await dbQuery("SELECT player, status, paid, depth, server_seed, server_hash, client_seed FROM rtv_seeds WHERE run_id=?", [runId]).catch(() => []))[0];
      if (!row || !Number(row.paid)) return res.json({ ok: false });
      if (row.status !== 'open') return res.json({ ok: true, already: true });   // already busted/cashed/robbed — nothing to add
      const depth = Math.max(0, Math.min(LEVELS, num(req.body && req.body.depth) || num(row.depth)));
      if (depth < CASHOUT_MIN) return res.json({ ok: false });   // below the cash-out gate — not a cash-out
      await dbExec("UPDATE rtv_seeds SET status='cashed', depth=? WHERE run_id=? AND status='open'", [depth, runId]);
      const chk = (await dbQuery("SELECT status FROM rtv_seeds WHERE run_id=?", [runId]).catch(() => []))[0];
      if (!chk || chk.status !== 'cashed') return res.json({ ok: true, already: true });   // lost the race
      // AUDIT 2026-09-09: derive the leaderboard "won" SERVER-SIDE so a client can't inject an inflated figure into the public
      // board. The cash-out paid potShareFor(depth) of the pot; reading potRvlt() AFTER the payout, pre = post/(1-share), so
      // won = share*post/(1-share) reconstructs the actual amount from chain state. Fall back to the client delta only if the read fails.
      let won;
      try {
        const pot = await new ethers.Contract(OC.vault, VAULT_READ_ABI, roProv()).potRvlt();
        const potAfter = Number(ethers.formatUnits(pot, 18)); const share = potShareFor(depth);
        won = (share > 0 && share < 1) ? Math.max(0, Math.round(potAfter * share / (1 - share))) : Math.max(0, Math.round(num(req.body && req.body.won)));
      } catch (e) { won = Math.max(0, Math.round(num(req.body && req.body.won))); }
      await dbExec("INSERT INTO rtv_runs (player,stake,depth,outcome,won_rvlt,net,server_seed,server_hash,client_seed) VALUES (?,?,?,?,?,?,?,?,?)", [row.player, FEE, depth, 'cashout', won, OC.chainId, row.server_seed, row.server_hash, row.client_seed]).catch(() => {});
      res.json({ ok: true });
    });
  } catch (e) { res.json({ ok: false }); }
});

// EXIT-ON-MINT (server-authoritative). Minting a Vault Robber is the deliberate "walk away" that ENDS the paid run — the copy
// promises "minting ends the run, you can't keep playing", so it must hold server-side, not just as a client RUN=null. Without
// this, a user could mint and then replay the same runId against /api/crack (which only requires status='open'). Marking the run
// terminal here makes /api/crack, /api/cashout AND the settle-sig path all 400/409 with "no open run" — the exact rejection they
// already use for busted/cashed/robbed rows. Only a CONFIRMED mint calls this (client waits for the tx before firing); a voucher
// issue or a reverted/failed mint never reaches here, so a player who opens the sheet or whose mint fails KEEPS their paid run.
// Idempotent + net-scoped like the rest; the runId (server-generated 32 random bytes) is the capability, same auth model as crack.
app.post('/api/robbers/mint-exit', async (req, res) => {
  try {
    const runId = String((req.body && req.body.runId) || '');
    if (!runId) return res.json({ ok: false });
    await withRunLock(runId, async () => {
      const row = (await dbQuery("SELECT player, status, net FROM rtv_seeds WHERE run_id=?", [runId]).catch(() => []))[0];
      if (!row) return res.json({ ok: false });
      if (Number(row.net) !== OC.chainId) return res.json({ ok: false });   // net-scoped: only end a run on THIS chain
      if (row.status !== 'open') return res.json({ ok: true, already: true });   // already terminal (busted/cashed/robbed/minted) — nothing to do
      // Defense-in-depth: if the client sends the minter address, it must be the run's own owner. The runId secret is the
      // primary capability (as with crack/cashout); this is an extra, best-effort ownership check, not the sole gate.
      const minter = String((req.body && req.body.minter) || '');
      if (minter && ethers.isAddress(minter) && row.player && ethers.getAddress(minter).toLowerCase() !== String(row.player).toLowerCase()) {
        return res.status(403).json({ error: 'not your run' });
      }
      // Consume the run: flip to a terminal status so no further crack/cashout/settle can act on it (all require status='open').
      await dbExec("UPDATE rtv_seeds SET status='minted' WHERE run_id=? AND status='open'", [runId]);
      const chk = (await dbQuery("SELECT status FROM rtv_seeds WHERE run_id=?", [runId]).catch(() => []))[0];
      if (!chk || chk.status !== 'minted') return res.json({ ok: true, already: true });   // lost the race to another terminal op
      res.json({ ok: true, ended: true });
    });
  } catch (e) { res.json({ ok: false }); }
});

app.get('/api/health', (req, res) => res.json({ ok: true }));
// Force fresh code on every load for HTML + JS. Mobile in-app wallet browsers (OKX, MetaMask, etc.) cache JS/HTML so aggressively
// that players kept running STALE builds after fixes shipped (Jake 2026-09-04: mobile showed a "no gas / open Testnet panel" error
// from old code even though the wallet had mainnet gas). no-store on .html/.js guarantees the current build; images/fonts still cache.
// PROD CLIENT OBFUSCATION (Jake 2026-09-13). RTV_OBFUSCATE=1 (public prod only) minifies the game-LOGIC client files on the fly — strips the
// explanatory comments (the real intel) + mangles locals — so the shipped JS is annoying to reverse-engineer. Security does NOT depend on this
// (the client is client-untrusted: seed-not-answer, server-graded, run-bound API); it's a defense-in-depth speed-bump. FAIL-SAFE: any minify error
// falls through to express.static serving the original, so it can never break the game. Cached by mtime (auto-reflects new builds). Twin serves readable.
if (process.env.RTV_OBFUSCATE === '1') {
  const _terser = require('terser'); const _fsO = require('fs'); const _pathO = require('path');
  const _MINSET = new Set(['skillgames-remote.js', 'skillgames-ui.js', 'onchain.js', 'casino-ui.js']);   // logic files (translations/vendor excluded)
  const _minCache = new Map();
  app.get(/\.js$/i, async (req, res, next) => {
    try {
      const name = req.path.replace(/^\/+/, '');
      if (!_MINSET.has(name)) return next();
      const fp = _pathO.join(__dirname, 'public', name);
      if (!_fsO.existsSync(fp)) return next();
      const st = _fsO.statSync(fp), key = name + ':' + st.mtimeMs;
      let code = _minCache.get(key);
      if (code == null) {
        const src = _fsO.readFileSync(fp, 'utf8');
        const r = await _terser.minify(src, { compress: true, mangle: true, format: { comments: false } });
        code = (r && r.code) ? r.code : null;   // minify failed -> null -> fall through to static (original)
        if (code) { _minCache.clear(); _minCache.set(key, code); }
      }
      if (!code) return next();
      res.set('Content-Type', 'application/javascript'); res.set('Cache-Control', 'no-cache, no-store, must-revalidate'); return res.end(code);
    } catch (e) { return next(); }   // any error -> serve the original (never break the game)
  });
}
app.use(express.static('public', {
  setHeaders: (res, p) => {
    if (/\.(html|js)$/i.test(p)) res.set('Cache-Control', 'no-cache, no-store, must-revalidate');
    else if (/\.(png|jpg|jpeg|webp|gif|svg|woff2?|ttf|mp3|wav|ogg)$/i.test(p)) res.set('Cache-Control', 'public, max-age=604800');
  }
}));

// Process-level crash guards — a single uncaught rejection (e.g. a dropped RPC socket mid-run) must never take the
// game process down during launch. Log and keep serving (mirrors the EmblemScan crash-hardening).
process.on('unhandledRejection', (e) => { try { console.error('[rtv] unhandledRejection:', (e && (e.stack || e.message)) || e); } catch (_) {} });
process.on('uncaughtException', (e) => { try { console.error('[rtv] uncaughtException:', (e && (e.stack || e.message)) || e); } catch (_) {} });

// ── Casino rooms — DECOUPLED from RTV_V2 (Jake 2026-09-13): held for a POST-LAUNCH rebuild, gated on its own RTV_CASINO flag (OFF for the V2 launch). Provably-fair, RVLT-denominated, house-edge-protected. Source intact. ──
if (V2 && CASINO_ON) {
  try {
    const casino = require('./casino.js');
    casino.mountCasino(app, { dbQuery, dbExec, rateOk, clientIp: _clientIp, net: OC.chainId });
    console.log('[rtv-v2] casino mounted (edge', casino.HOUSE_EDGE + ', games: crash/mines/plinko/dice/wheel)');
  } catch (e) { console.error('[rtv-v2] casino mount failed:', e && e.message); }
}
// ── Skill Engine v4 (seed-not-answer) — flag-gated, detached from the live skill path until proven. ──
if (process.env.RTV_SKILL_V4 === 'on') {
  try { require('./skillv4.js').mountSkillV4(app, { rateOk, clientIp: _clientIp }); }
  catch (e) { console.error('[rtv-v4] skill v4 mount failed:', e && e.message); }
}

// One-shot on-chain funder backfill (A3): resolves funders for recent players via the partner key, ONCE, paced by the _rsGate
// bill-guard, then drops a DB sentinel so it never re-runs across restarts. Skips already-cached wallets. Off with RTV_FUNDER_BACKFILL=off.
async function oneShotFunderBackfill() {
  if (!RS_KEY || process.env.RTV_FUNDER_BACKFILL === 'off') return;
  const BF_NET = Number(process.env.RTV_FUNDER_BACKFILL_NET || 4663);   // robinscan is a 4663-mainnet explorer; that's where the attack cohort lives (the testnet twin has no on-chain history there)
  try {
    if ((await dbQuery("SELECT 1 FROM rtv_wallet_funder WHERE wallet='__backfill_done__' AND net=?", [BF_NET]))[0]) return;
    const cap = Math.max(1, Math.min(200, Number(process.env.RTV_FUNDER_BACKFILL_CAP || 150)));
    const players = (await dbQuery("SELECT DISTINCT player FROM rtv_seeds WHERE net=? AND player IS NOT NULL ORDER BY ts DESC LIMIT ?", [BF_NET, cap])).map(r => r.player).filter(Boolean);
    let resolved = 0, scanned = 0;
    for (const p of players) { if ((await dbQuery("SELECT 1 FROM rtv_wallet_funder WHERE wallet=? AND net=?", [String(p).toLowerCase(), BF_NET]))[0]) continue; scanned++; const f = await funderOf(p, BF_NET); if (f) resolved++; }
    await dbExec("INSERT OR IGNORE INTO rtv_wallet_funder (wallet,funder,net) VALUES ('__backfill_done__','__done__',?)", [BF_NET]).catch(() => {});
    console.log('[rtv-a3] one-shot funder backfill (net ' + BF_NET + ') done: scanned ' + scanned + ', resolved ' + resolved + ' (partner spent ~' + _rsSpent + ' calls)');
  } catch (e) { console.warn('[rtv-a3] funder backfill error:', e.message); }
}
// WORLD/ROOM behaviour capture (Jake 2026-09-13). The client posts a per-chamber navigation + interaction summary (movement, look turns, time
// in room, door-approach path, How-it-works clicks, game browsing, pointer jitter, touch-hold, dead-clicks). MEASUREMENT-ONLY, best-effort,
// size-capped, never affects gameplay. run_id links to rtv_seeds for the player; features are a schema-free JSON blob so we can add signals freely.
// ── ADDITION 2: HEADLESS / AUTOMATION DETECTION AT THE DOOR (server) ──────────────────────────────────────────────────
// The client posts a one-time environment probe at run start (mirrors the api/behavior collector pattern). We compute a
// headless_score 0..1 from unfakeable-ish mismatches (webdriver flag, headless UA, software WebGL renderer, zero cores/plugins,
// coarse-pointer-but-no-touch, etc.), store the raw signals, and fold the score into the EXISTING humanness/telemetry plumbing.
// SOFT ONLY: a high score triggers the existing markBotFlag() path with a NON-hard 'automation_env' reason. Never a hard gate.
function _headlessScore(sig) {
  const reasons = []; let s = 0;
  try {
    const ua = String(sig.userAgent || '').toLowerCase();
    const rend = String(sig.webglRenderer || '').toLowerCase();
    const desktopUA = !/(android|iphone|ipad|ipod|mobile)/.test(ua);
    if (sig.webdriver === true) { s += 0.5; reasons.push('webdriver'); }
    if (/headless/.test(ua)) { s += 0.4; reasons.push('headless_ua'); }
    if (/swiftshader|llvmpipe|(^|[^a-z])mesa([^a-z]|$)|software|angle \(software/.test(rend)) { s += 0.3; reasons.push('software_webgl'); }
    if (!sig.webglRenderer && !sig.webglVendor) { s += 0.1; reasons.push('no_webgl'); }
    if (Number(sig.hardwareConcurrency) === 0) { s += 0.15; reasons.push('cores=0'); }
    if (sig.deviceMemory === 0) { s += 0.1; reasons.push('devmem=0'); }
    if (Number(sig.pluginsLength) === 0 && desktopUA) { s += 0.1; reasons.push('no_plugins_desktop'); }
    if (sig.pointerCoarse === true && Number(sig.maxTouchPoints) === 0) { s += 0.15; reasons.push('coarse_no_touch'); }
    if (sig.chrome === false && /chrome\//.test(ua) && desktopUA) { s += 0.1; reasons.push('chrome_ua_no_chrome_obj'); }
    if (Array.isArray(sig.languages) && sig.languages.length === 0) { s += 0.1; reasons.push('no_languages'); }
  } catch (e) {}
  return { score: Math.max(0, Math.min(1, s)), reasons };
}
const HEADLESS_HIGH = Number(process.env.RTV_HEADLESS_HIGH || 0.6);   // soft flag threshold (conservative; a real desktop browser scores ~0)
app.post('/api/clientenv', express.json({ limit: '16kb' }), async (req, res) => {
  try {
    const runId = String((req.body && req.body.runId) || '').slice(0, 64);
    const sig = (req.body && req.body.signals) || {};
    let sigStr = ''; try { sigStr = JSON.stringify(sig).slice(0, 4000); } catch (e) { sigStr = '{}'; }
    const _fp = _reqFP(req);
    let player = null; try { if (runId) { const rr = (await dbQuery("SELECT player FROM rtv_seeds WHERE run_id=?", [runId]))[0]; player = rr ? rr.player : null; } } catch (e) {}
    const hs = _headlessScore(sig);
    dbExec("INSERT INTO rtv_client_env (run_id,player,net,ip_hash,ua_hash,webdriver,headless_score,signals) VALUES (?,?,?,?,?,?,?,?)", [runId, player, OC.chainId, _fp.ip, _fp.ua, sig.webdriver === true ? 1 : 0, hs.score, sigStr]).catch(() => {});
    // SOFT feed: high automation score adds a NON-hard flag through the existing bot-role accumulator (guards false positives via _BOT_SOFT_THRESH).
    if (player && hs.score >= HEADLESS_HIGH) { try { markBotFlag(player, 'automation_env(' + hs.reasons.join('|') + ')', false, _fp.ip, _fp.ua); } catch (e) {} }
    res.json({ ok: true });
  } catch (e) { res.json({ ok: false }); }
});

app.post('/api/behavior', express.json({ limit: '32kb' }), async (req, res) => {
  try {
    const runId = String((req.body && req.body.runId) || '').slice(0, 64);
    const level = Math.max(0, Math.min(20, parseInt(req.body && req.body.level, 10) || 0));
    const behavior = req.body && req.body.behavior;
    if (!runId || behavior == null) return res.json({ ok: false });
    let bstr = ''; try { bstr = JSON.stringify(behavior).slice(0, 6000); } catch (e) { return res.json({ ok: false }); }
    const _fp = _reqFP(req);
    let player = null; try { const rr = (await dbQuery("SELECT player FROM rtv_seeds WHERE run_id=?", [runId]))[0]; player = rr ? rr.player : null; } catch (e) {}
    dbExec("INSERT INTO rtv_room_behavior (run_id,player,net,level,ip_hash,ua_hash,behavior) VALUES (?,?,?,?,?,?,?)", [runId, player, OC.chainId, level, _fp.ip, _fp.ua, bstr]).catch(() => {});
    res.json({ ok: true });
  } catch (e) { res.json({ ok: false }); }
});

ensureSchema().finally(() => { app.listen(process.env.PORT || 3000, () => console.log('[rtv] listening on', process.env.PORT || 3000)); setTimeout(oneShotFunderBackfill, 8000); _loadBotRoles().catch(() => {}); });
