}
// DETERMINISTIC effective bar for a door, incl. PER-DOOR SHALLOW VARIATION (Jake 2026-09-13). Base = the hand-tuned DET_* ramp; then a
// seed-derived offset (provably-fair, identical on retry) makes the 3 doors in a shallow room differ (~±0.14 at ch1) so luck isn't the
// auto-pick, shrinking to 0 by the deep vault rooms (which stay uniform + hard). Continuous-scored doors only — perception is a binary
// right-answer K-gate (offset meaningless), luck has no bar.
const _DET_BARVAR = [0.14, 0.12, 0.10, 0.08, 0.06, 0.03, 0.015, 0, 0, 0];
function detBar(kind, dt, lvl, door, seed) {
  let bar = kind === 'perception' ? ((_v4 && _v4.s.DET_PERCEPTION_BAR_T) ? _v4.s.DET_PERCEPTION_BAR_T[dt][lvl - 1] : 0.5)
    : kind === 'dexterity' ? (_v4.s.DET_DEXTERITY_BAR_T || _v4.s.DEXTERITY_BAR_T)[dt][lvl - 1]
      : (_v4.s.DET_SKILL_BAR_T || _v4.s.SKILL_BAR_T)[dt][lvl - 1];
  if (kind === 'dexterity' || kind === 'skill') { const sp = _DET_BARVAR[lvl - 1] || 0; if (sp > 0) { const o = (_u(_hb(String(seed) + ':' + door + ':' + lvl, 'barvar'), 3) * 2 - 1) * sp; bar = Math.max(0.05, Math.min(0.97, bar + o)); } }
