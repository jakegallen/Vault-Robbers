        // calibrated so P(competent human clears) ~= DET_CLEAR per (tier,level); rarity comes from difficulty, not a hidden roll.
        const _bar = detBar(act.kind, _dt, level, act.door, row.server_seed);   // hand-tuned ramp + per-door shallow variation (provably-fair)
        success = !failedMini && (score >= _bar);
      }
