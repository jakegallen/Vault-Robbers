}
const feeFor = (holds) => Math.round(FEE * (1 - (holds ? HOLDER_DISCOUNT : 0)));   // 2000, or 1000 for holders
// %-OF-POT payout ladder: cashing out at stage k takes this share of the CURRENT pot. Self-solvent + self-capping.
const POT_LADDER = { 5: 0.01, 6: 0.03, 7: 0.10, 8: 0.20, 9: 0.30 };        // V2 ladder (Jake 2026-09-07): 1/3/10/20/30%. MUST match the on-chain potLadderBps (setLadder 100/300/1000/2000/3000, executed via Safe + verified on-chain 2026-09-07) so the displayed cashout offer equals what the contract pays. Core (10) via crackCore: choose 100% ETH OR 100% pot.
const potShareFor = (depth) => (depth >= LEVELS ? 1.0 : (POT_LADDER[depth] || 0));
// ── Buy-Burn-Earn ladder V2 (Jake 2026-09-11): every tier = min(pct*pot, cap), floored so a cash-out can't drain the pot.
//    Keyed by CLEARED depth (5-9) == the chamber the player is STANDING IN (6-10) in player copy. Owner-settable at runtime
//    via /api/admin/ladder. FLAG-GATED (RTV_LADDER_V2) until the on-chain pct+cap ladder ships, so the displayed offer never
//    desyncs from what the contract actually pays. Server values MUST mirror the contract's setLadder(pctBps,cap).
const LADDER_V2_ON = process.env.RTV_LADDER_V2 === 'on';
const POT_PAY_FLOOR_STATE = { v: Number(process.env.RTV_POT_PAYFLOOR || 100000) };   // underflow guard (runtime-mutable via /api/admin/ladder): a cash-out never takes the pot below this
let LADDER_V2 = {                        // cleared-depth -> { pct (0..1), cap (RVLT) }
  5: { pct: 0.01, cap: 1000 },           // standing Ch6 — half your 2,000 back
  6: { pct: 0.03, cap: 3000 },           // Ch7
  7: { pct: 0.05, cap: 9000 },           // Ch8
  8: { pct: 0.10, cap: 800000 },         // Ch9
  9: { pct: 0.25, cap: 2000000 }         // Ch10 — or crack the core for the ETH vault
};
// RVLT payout for a cash-out at cleared `depth`, given the current pot. Capped + floored. Core (depth>=LEVELS) = ETH via crackCore (0 here).
function payoutFor(depth, pot) {
  pot = Math.max(0, Number(pot) || 0);
  if (depth >= LEVELS) return 0;
  if (!LADDER_V2_ON) return Math.floor(pot * potShareFor(depth));   // legacy pure-% until the capped on-chain ladder is live
  const t = LADDER_V2[depth]; if (!t) return 0;
  const avail = Math.max(0, pot - POT_PAY_FLOOR_STATE.v);
