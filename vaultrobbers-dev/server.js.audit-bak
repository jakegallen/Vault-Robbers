      else if (act.kind === 'rhythm') success = (score >= _v4.s.RHYTHM_BAR_T[_dt][level - 1]) && (r < _v4.s.RHYTHM_ROLL_T[_dt][level - 1]);   // beat the per-tier competence bar, then the per-tier roll
      else if (act.kind === 'dexterity') success = (score >= _v4.s.DEXTERITY_BAR_T[_dt][level - 1]) && (r < _v4.s.DEXTERITY_ROLL_T[_dt][level - 1]);
