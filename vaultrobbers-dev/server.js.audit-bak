      // provably-fair ROLL that closes the residual to baseOdds(lvl,door), so ALL doors/tiers land on the SAME backbone (the anti-farm
      // invariant: no soft lane, category is pure flavor/variance). LUCK keeps its own roll. `r` is the provably-fair roll for this run.
      const _dt = (act.door && _v4.s.SKILL_BAR_T[act.door]) ? act.door : 'center';   // per-tier column (Left easier+smaller reward / Right harder+bigger / Center = backbone)
      if (DETERMINISTIC && act.kind !== 'luck') {
